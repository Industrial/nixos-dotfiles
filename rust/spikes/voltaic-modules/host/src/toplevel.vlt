-- The "toplevel": the evaluated configuration projected into one
-- derivation, emitted as ATerm. Evaluation runs as an id_effect program at
-- `R = HNil`, so it holds no capability; the derivation is computed from the
-- merged options and the package index alone.

import id_effect::{Effect, HNil}
import modsys::drv::{Emitted, emit}
import modsys::eval::{EvalError, Registry, value}
import modsys::pure::evaluated
import crate::host::modules
import crate::modules::{HELLO_ENABLE, HELLO_GREETING, HOST_NAME, SYSTEM_PACKAGES}
import crate::pkgs::BASH

export data Toplevel {
  export host_name String,
  export packages usize,
  export emitted Emitted,
}

project : &Registry -> Result<Toplevel, EvalError>
project reg =
  host_name = (value reg (&HOST_NAME))?
  enabled = (value reg (&HELLO_ENABLE))?
  greeting = (value reg (&HELLO_GREETING))?
  packages = (value reg (&SYSTEM_PACKAGES))?
  script = if enabled
    "echo \"#{greeting}\" > $out"
  else
    String::from "touch $out"
  builder = "#{BASH.out}/bin/bash"
  args = [String::from "-c", script].to_vec ()
  emitted = (emit "s1b-hello" "x86_64-linux" builder args (Vec::new ()) (&packages)
    |> .map_err EvalError::Emit)?
  Ok (Toplevel {
    host_name,
    packages = packages.len (),
    emitted,
  })

export toplevel : Effect<Toplevel, EvalError, HNil>
toplevel = evaluated modules project
