-- One host's configuration: the modules it imports and its own definitions.
-- This is the file a config change edits; the compile-latency measurement
-- in docs/research/417/s1b-voltaic-feature-check.md times an edit here.
--
-- Priorities at work: the profile says `hostName = mkDefault "nixos-test"`,
-- the host says `"muninn"` (100 beats 1000); `hello` defaults its greeting
-- from the host name at mkDefault and the host forces it (50).

import modsys::eval::{EvalError, Module, Out, Registry, View, define}
import modsys::option::{DEFAULT, FORCE, NORMAL}
import crate::modules::{HELLO_ENABLE, HELLO_GREETING, HOST_NAME, environment, hello, networking}

no_declarations : &mut Registry -> &'static str -> Result<(), EvalError>
no_declarations _ _ = Ok ()

profile_body : &View -> &mut Out -> Result<(), EvalError>
profile_body _ out =
  define out (&HOST_NAME) DEFAULT (String::from "nixos-test")
  Ok ()

profile : Module
profile = Module {
  name = "profiles/test",
  reads = Vec::new (),
  writes = [HOST_NAME.path].to_vec (),
  declares = Box::new no_declarations,
  body = Box::new profile_body,
}

host_body : &View -> &mut Out -> Result<(), EvalError>
host_body _ out =
  define out (&HOST_NAME) NORMAL (String::from "muninn")
  define out (&HELLO_ENABLE) NORMAL true
  define out (&HELLO_GREETING) FORCE (String::from "hi")
  Ok ()

host : Module
host = Module {
  name = "hosts/muninn",
  reads = Vec::new (),
  writes = [HOST_NAME.path, HELLO_ENABLE.path, HELLO_GREETING.path].to_vec (),
  declares = Box::new no_declarations,
  body = Box::new host_body,
}

export modules : Vec<Module>
modules = vec![networking(), environment(), hello(), profile(), host()]
