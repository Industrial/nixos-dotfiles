-- The pinned package index's generator: for each attribute, its `.drv`, its
-- `out` path and its modulo hash, written out as Voltaic `Pkg` constants. A
-- host configuration imports the generated file, so a package that is not in
-- the index is a compile error, and emitting a derivation reads no file.
--
-- This is the one place that reads the store (the `.drv` closure, to compute
-- modulo hashes). It runs once per lock bump, like `vbump`, never during a
-- configuration's evaluation.

import std::collections::BTreeMap
import nix_store_core::drv::read
import nix_store_core::hash::to_base16
import crate::drv::hash_modulo

-- The modulo hash (base16) of a `.drv` and, memoised, of its whole closure.
export modulo_of : &str -> &mut BTreeMap<String, String> -> Result<String, String>
modulo_of path memo =
  case memo.get path of
    Some m -> Ok (m.clone ())
    None -> computed path memo

computed : &str -> &mut BTreeMap<String, String> -> Result<String, String>
computed path memo =
  d = (read (std::path::Path::new path))?
  mut inputs = BTreeMap::new ()
  for p in d.input_drvs.keys ()
    m = (modulo_of p memo)?
    inputs.insert (p.clone ()) m
  m = to_base16 (&(hash_modulo (&d) (&inputs))?)
  memo.insert (path.to_string ()) (m.clone ())
  Ok m

-- One `Pkg` constant: `export const BASH : Pkg = Pkg { … }`.
export constant : &str -> &str -> &str -> &str -> String
constant attr drv out modulo =
  name = attr.to_uppercase ().replace "-" "_"
  "export const #{name} : Pkg = Pkg {\n  attr = \"#{attr}\",\n  drv = \"#{drv}\",\n  out = \"#{out}\",\n  modulo = \"#{modulo}\",\n}\n"

-- `gen-index attr=/nix/store/…drv …`: the generated `pkgs.vlt` on stdout.
export cli : Result<(), String>
cli =
  mut memo = BTreeMap::new ()
  println! \-> "-- Generated by `gen-index`. Do not edit."
  println! \-> "import modsys::drv::Pkg"
  for arg in (std::env::args ()).skip 1
    (attr, path) = (arg.split_once "="
      |> .ok_or (format! \-> "expected attr=drv, got #{arg}"))?
    d = (read (std::path::Path::new path))?
    out = (d.outputs.get "out"
      |> .ok_or (format! \-> "#{path} has no out"))?
    m = (modulo_of path (&mut memo))?
    println!()
    print! \-> "#{constant attr path (&out.path) (&m)}"
  Ok ()
