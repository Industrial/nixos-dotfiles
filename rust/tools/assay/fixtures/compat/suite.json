{
  "trim_identity": {
    "expr": "builtins.replaceStrings [\" \"] [\"\"] \"  hi  \"",
    "expected": "\"hi\""
  },
  "list_len": {
    "expr": "builtins.length [ 1 2 3 ]",
    "expected": "3"
  },
  "bool_and": {
    "expr": "true && false",
    "expected": "false"
  },
  "attr_get": {
    "expr": "{ a = 1; }.a",
    "expected": 1
  },
  "list_concat": {
    "expr": "[ 1 2 ] ++ [ 3 ]",
    "expected": [1, 2, 3]
  },
  "null_lit": {
    "expr": "null",
    "expected": "null"
  }
}
