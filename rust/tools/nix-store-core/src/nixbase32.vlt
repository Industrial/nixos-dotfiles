-- Nix's base-32: the alphabet without e, o, u and t, read from the last
-- character backwards. A narinfo's NarHash is this encoding of the NAR's
-- SHA-256, while the store database keeps the same digest as base-16.

export const ALPHABET : &[u8] = b"0123456789abcdfghijklmnpqrsvwxyz"

-- Characters needed for `n` bytes: ceil(n * 8 / 5).
export encoded_len : usize -> usize
encoded_len n
  | n == 0 = 0
  | _ = (n * 8 - 1) / 5 + 1

-- Five bits per character, the highest-numbered group first, the way
-- libutil's `printHash32` writes it.
export encode : &[u8] -> String
encode bytes =
  n = bytes.len ()
  len = encoded_len n
  mut out = String::with_capacity len
  for k in 0 .. len
    i = len - 1 - k
    b = i * 5
    c = b / 8
    j = b % 8
    lo = usize::from (bytes[c]) >> j
    hi = if c + 1 < n
      usize::from (bytes[c + 1]) << (8 - j)
    else
      0
    out.push (char::from (ALPHABET[(lo | hi) & 31]))
  out

-- The inverse of `encode`, libutil's `parseHash32`: the byte count is the
-- one whose encoding has exactly this many characters. None for a character
-- outside the alphabet, a length no byte count encodes to, or high bits set
-- past the last byte.
export decode : &str -> Option<Vec<u8>>
decode s =
  raw = s.as_bytes ()
  len = raw.len ()
  size = len * 5 / 8
  if encoded_len size != len
    return None
  mut out = vec![0u8; size]
  for n in 0 .. len
    c = raw[len - n - 1]
    digit = (ALPHABET.iter () |> .position (\a -> *a == c))?
    b = n * 5
    i = b / 8
    j = b % 8
    shifted = digit << j
    out[i] := out[i] | (u8::try_from (shifted & 255) |> .unwrap_or 0)
    carry = shifted >> 8
    if i + 1 < size
      out[i + 1] := out[i + 1] | (u8::try_from carry |> .unwrap_or 0)
    else if carry != 0
      return None
  Some out

-- Bytes as lower-case base-16, the form the store database keeps.
export encode_hex : &[u8] -> String
encode_hex bytes =
  bytes.iter () |> .map (\b -> format! \-> "#{b:02x}") |> .collect

-- One base-16 digit, either case.
hex_digit : u8 -> Option<u8>
hex_digit c
  | c.is_ascii_digit () = Some (c - b'0')
  | (b'a' ..= b'f').contains (&c) = Some (c - b'a' + 10)
  | (b'A' ..= b'F').contains (&c) = Some (c - b'A' + 10)
  | _ = None

-- Base-16 to bytes; None for an odd length or a non-hex character.
export decode_hex : &str -> Option<Vec<u8>>
decode_hex s =
  raw = s.as_bytes ()
  if !raw.len ().is_multiple_of 2
    return None
  mut out = Vec::with_capacity (raw.len () / 2) : Vec<u8>
  for pair in raw.chunks 2
    hi = (hex_digit (pair[0]))?
    lo = (hex_digit (pair[1]))?
    out.push (hi * 16 + lo)
  Some out

-- Whether every character is one Nix's base-32 can produce.
export is_nixbase32 : &str -> bool
is_nixbase32 s =
  s.bytes () |> .all (\c -> ALPHABET.contains (&c))

-- A database hash (`sha256:<base16>`) in narinfo form (`sha256:<nix32>`).
-- A hash that is already base-32 is passed through unchanged.
export narinfo_hash : &str -> Option<String>
narinfo_hash db_hash =
  (algo, digest) = (db_hash.split_once ':')?
  if digest.len () == 64
    bytes = (decode_hex digest)?
    Some (format! \-> "#{algo}:#{encode (&bytes)}")
  else if is_nixbase32 digest
    Some (db_hash.to_string ())
  else
    None

test "the empty input encodes to nothing"
  assert_eq! \-> encode (&[]) \-> ""

test "one zero byte is two zero characters"
  assert_eq! \-> encode (&[0]) \-> "00"

test "a known SHA-256 matches nix hash convert"
  -- nix hash convert --hash-algo sha256 --to nix32 \
  --   044b884fce3dd89e5cd04f725b59c2abf51f0c2b496830d3f186107269cda902
  bytes = decode_hex "044b884fce3dd89e5cd04f725b59c2abf51f0c2b496830d3f186107269cda902"
  assert_eq! \-> bytes.map (\b -> encode (&b)) \-> Some (.to_string "00m9rmlp4446y79k0s295c61zxdbq9cmnwjgs1f9xn1xrr7qhjq4")

test "a database hash becomes a narinfo hash"
  assert_eq! \-> narinfo_hash "sha256:044b884fce3dd89e5cd04f725b59c2abf51f0c2b496830d3f186107269cda902" \-> Some (.to_string "sha256:00m9rmlp4446y79k0s295c61zxdbq9cmnwjgs1f9xn1xrr7qhjq4")

test "a base-32 hash passes through"
  assert_eq! \-> narinfo_hash "sha256:00m9rmlp4446y79k0s295c61zxdbq9cmnwjgs1f9xn1xrr7qhjq4" \-> Some (.to_string "sha256:00m9rmlp4446y79k0s295c61zxdbq9cmnwjgs1f9xn1xrr7qhjq4")

test "malformed hex is refused"
  assert! \-> decode_hex "abc" == None
  assert! \-> decode_hex "zz" == None

test "decode inverts encode"
  bytes = decode_hex "044b884fce3dd89e5cd04f725b59c2abf51f0c2b496830d3f186107269cda902"
  assert_eq! \-> decode "00m9rmlp4446y79k0s295c61zxdbq9cmnwjgs1f9xn1xrr7qhjq4" \-> bytes
  assert_eq! \-> decode "" \-> Some (Vec::new ())
  assert_eq! \-> decode "00" \-> Some (.to_vec ([0]))

test "decode refuses what no encoding produces"
  assert_eq! \-> decode "e0" \-> None
  assert_eq! \-> decode "0" \-> None
  assert_eq! \-> decode "z0" \-> None

test "bytes as base-16"
  assert_eq! \-> encode_hex (&[0, 15, 255]) \-> "000fff"
