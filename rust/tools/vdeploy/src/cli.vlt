-- vdeploy's command line, parsed into `Options` by a pure function.
--
--   vdeploy --host NAME [--once] [--url URL] [--branch NAME] [--repo DIR]
--           [--interval DURATION] [--debounce DURATION] [--tick DURATION]
--           [--state-dir DIR] [--textfile-dir DIR] [--db FILE]
--           [--git PROG] [--nix PROG]
--           [--dotfiles PATH [--dotfiles-user USER] [--dotfiles-group GROUP]
--            [--dotfiles-home DIR]]
--
--   vdeploy apply [--toplevel PATH] [--state-dir DIR] [--textfile-dir DIR]
--           [--health-window DURATION] [--health-every DURATION]
--           [--vhealth PROG] [--profile PATH] [--gcroot PATH]
--           [--nix-env PROG] [--nix-store PROG] [--systemctl PROG]
--           [--comin-unit UNIT] [--health-as USER [--health-group GROUP] [--setpriv PROG]]
--
-- `--trusted-keys KEYRING` (GH-221): check each head's signature with gpgv
-- (`--gpgv`) against that keyring, and record the verdict in the plan; with
-- `--require-signed`, a head that does not verify is refused, never planned.
-- `--mode observe` (the default) plans and logs, and never switches.
-- `--mode deploy` (#160) runs each switching plan through `vdeploy apply`
-- in a transient unit: switch (test), health check, then the boot entry or a
-- rollback. The daemon passes its apply options on to that unit.
-- Durations are bare seconds or a number with s, m, h or d.

import nix_store_core::db

export const USAGE : &str = "usage: vdeploy --host NAME [--mode observe|deploy] [--once] [--url URL] [--branch NAME] [--repo DIR] [--interval DURATION] [--debounce DURATION] [--tick DURATION] [--state-dir DIR] [--textfile-dir DIR] [--db FILE] [--git PROG] [--nix PROG] [--dotfiles PATH [--dotfiles-user USER] [--dotfiles-group GROUP] [--dotfiles-home DIR]] [APPLY OPTIONS] [--systemd-run PROG] [--wake-fifo PATH] [--trusted-keys KEYRING [--require-signed] [--gpgv PROG]]\n       vdeploy wake [--wait] [--timeout DURATION] [--fifo PATH] [--state-dir DIR]\n       vdeploy apply [--toplevel PATH] [--state-dir DIR] [--textfile-dir DIR] [APPLY OPTIONS]\nAPPLY OPTIONS: [--health-window DURATION] [--health-every DURATION] [--vhealth PROG] [--profile PATH] [--gcroot PATH] [--nix-env PROG] [--nix-store PROG] [--systemctl PROG] [--comin-unit UNIT] [--health-as USER [--health-group GROUP] [--setpriv PROG]]"

export const DEFAULT_URL : &str = "https://github.com/Industrial/nixos-dotfiles.git"

export data Options
  { export host String
  , export once bool
  , export url String
  , export branch String
  , export repo String
  , export interval u64
  , export debounce u64
  , export tick u64
  , export state_dir Option<String>
  , export textfile_dir Option<String>
  , export db String
  , export git String
  , export nix String
  , export dotfiles Option<String>
  , export dotfiles_user Option<String>
  , export dotfiles_group Option<String>
  , export dotfiles_home Option<String>
  , export help bool
  , export deploy bool
  , export apply bool
  , export toplevel Option<String>
  , export health_window u64
  , export health_every u64
  , export systemd_run String
  , export systemctl String
  , export nix_env String
  , export nix_store String
  , export profile String
  , export gcroot String
  , export vhealth Option<String>
  , export comin_unit String
  , export health_as Option<String>
  , export health_group Option<String>
  , export setpriv String
  , export wake_fifo Option<String>
  , export trusted_keys Option<String>
  , export require_signed bool
  , export gpgv String
  }
  deriving (Clone, Debug, PartialEq)

export defaults : Options
defaults = Options { host = String::new (), once = false, url = DEFAULT_URL.to_string (), branch = .to_string "main", repo = .to_string "/var/lib/vdeploy/repo", interval = 60, debounce = 0, tick = 5, state_dir = None, textfile_dir = None, db = db::DEFAULT_DB.to_string (), git = .to_string "git", nix = .to_string "nix", dotfiles = None, dotfiles_user = None, dotfiles_group = None, dotfiles_home = None, help = false, deploy = false, apply = false, toplevel = None, health_window = 120, health_every = 2, systemd_run = .to_string "systemd-run", systemctl = .to_string "systemctl", nix_env = .to_string "nix-env", nix_store = .to_string "nix-store", profile = .to_string "/nix/var/nix/profiles/system", gcroot = .to_string "/nix/var/nix/gcroots/vdeploy/candidate", vhealth = None, comin_unit = .to_string "comin.service", health_as = None, health_group = None, setpriv = .to_string "setpriv", wake_fifo = None, trusted_keys = None, require_signed = false, gpgv = .to_string "gpgv" }

-- A duration in seconds: bare seconds, or a number with s/m/h/d.
export parse_duration : &str -> Option<u64>
parse_duration s =
  (digits, unit) = case s.char_indices () |> .find (\ic -> !(ic.1.is_ascii_digit ())) of
    Some (i, _) -> s.split_at i
    None -> (s, "")
  n = (digits.parse () : Result<u64, std::num::ParseIntError>) |> .ok
  scale = case unit of
    "" -> Some 1
    "s" -> Some 1
    "m" -> Some 60
    "h" -> Some 3600
    "d" -> Some 86400
    _ -> None
  n |> .zip scale |> .and_then (\p -> p.0.checked_mul p.1)

-- `--mode`: observe (plan and log only) or deploy (switch, health check, roll back).
export mode_of : &str -> Result<bool, String>
mode_of m =
  case m of
    "observe" -> Ok false
    "deploy" -> Ok true
    other -> Err "--mode: observe or deploy, not #{other}"

value : Option<&String> -> &str -> Result<String, String>
value v flag =
  case v of
    Some s -> Ok (s.clone ())
    None -> Err "#{flag} needs a value"

positive : Option<&String> -> &str -> Result<u64, String>
positive v flag =
  text = (value v flag)?
  parse_duration (&text) |> .filter (\n -> *n > 0) |> .ok_or ("#{flag}: not a positive duration: #{text}")

-- The options in `args` (argv without the program name).
export parse_args : &[String] -> Result<Options, String>
parse_args args =
  mut o = defaults ()
  mut it = args.iter ()
  if args.first () |> .map (\a -> a == "apply") |> .unwrap_or false
    o.apply := true
    _sub = it.next ()
  while it.next () is Some a
    case a.as_str () of
      "--mode" ->
        m = (value (it.next ()) "--mode")?
        o.deploy := (mode_of (&m))?
      "--toplevel" ->
        o.toplevel := Some ((value (it.next ()) "--toplevel")?)
      "--health-window" ->
        o.health_window := (positive (it.next ()) "--health-window")?
      "--health-every" ->
        o.health_every := (positive (it.next ()) "--health-every")?
      "--systemd-run" ->
        o.systemd_run := (value (it.next ()) "--systemd-run")?
      "--systemctl" ->
        o.systemctl := (value (it.next ()) "--systemctl")?
      "--nix-env" ->
        o.nix_env := (value (it.next ()) "--nix-env")?
      "--nix-store" ->
        o.nix_store := (value (it.next ()) "--nix-store")?
      "--profile" ->
        o.profile := (value (it.next ()) "--profile")?
      "--gcroot" ->
        o.gcroot := (value (it.next ()) "--gcroot")?
      "--vhealth" ->
        o.vhealth := Some ((value (it.next ()) "--vhealth")?)
      "--comin-unit" ->
        o.comin_unit := (value (it.next ()) "--comin-unit")?
      "--health-as" ->
        o.health_as := Some ((value (it.next ()) "--health-as")?)
      "--setpriv" ->
        o.setpriv := (value (it.next ()) "--setpriv")?
      "--trusted-keys" ->
        o.trusted_keys := Some ((value (it.next ()) "--trusted-keys")?)
      "--require-signed" ->
        o.require_signed := true
      "--gpgv" ->
        o.gpgv := (value (it.next ()) "--gpgv")?
      "--wake-fifo" ->
        o.wake_fifo := Some ((value (it.next ()) "--wake-fifo")?)
      "--health-group" ->
        o.health_group := Some ((value (it.next ()) "--health-group")?)
      "--host" ->
        o.host := (value (it.next ()) "--host")?
      "--once" ->
        o.once := true
      "--url" ->
        o.url := (value (it.next ()) "--url")?
      "--branch" ->
        o.branch := (value (it.next ()) "--branch")?
      "--repo" ->
        o.repo := (value (it.next ()) "--repo")?
      "--interval" ->
        o.interval := (positive (it.next ()) "--interval")?
      "--tick" ->
        o.tick := (positive (it.next ()) "--tick")?
      "--debounce" ->
        v = (value (it.next ()) "--debounce")?
        o.debounce := (parse_duration (&v) |> .ok_or ("--debounce: not a duration: #{v}"))?
      "--state-dir" ->
        o.state_dir := Some ((value (it.next ()) "--state-dir")?)
      "--textfile-dir" ->
        o.textfile_dir := Some ((value (it.next ()) "--textfile-dir")?)
      "--db" ->
        o.db := (value (it.next ()) "--db")?
      "--git" ->
        o.git := (value (it.next ()) "--git")?
      "--nix" ->
        o.nix := (value (it.next ()) "--nix")?
      "--dotfiles" ->
        o.dotfiles := Some ((value (it.next ()) "--dotfiles")?)
      "--dotfiles-user" ->
        o.dotfiles_user := Some ((value (it.next ()) "--dotfiles-user")?)
      "--dotfiles-group" ->
        o.dotfiles_group := Some ((value (it.next ()) "--dotfiles-group")?)
      "--dotfiles-home" ->
        o.dotfiles_home := Some ((value (it.next ()) "--dotfiles-home")?)
      "-h" ->
        o.help := true
      "--help" ->
        o.help := true
      other ->
        return Err "unknown argument: #{other}"
  if !o.help && !o.apply && o.host.is_empty ()
    return Err (.to_string "--host is required (the nixosConfigurations name of this host)")
  if o.require_signed && o.trusted_keys.is_none ()
    return Err (.to_string "--require-signed needs --trusted-keys (the keyring a head's signature is checked against)")
  if o.toplevel.is_some () && !o.apply
    return Err (.to_string "--toplevel is for `vdeploy apply`")
  if o.dotfiles.is_none () && (o.dotfiles_user.is_some () || o.dotfiles_group.is_some () || o.dotfiles_home.is_some ())
    return Err (.to_string "--dotfiles-user, --dotfiles-group and --dotfiles-home need --dotfiles")
  Ok o

-- `vdeploy wake [--wait] [--timeout DURATION] [--fifo PATH] [--state-dir DIR]`
-- (GH-246): the operator's command, no root needed.
export data WakeOptions { export wait bool, export timeout u64, export fifo String, export state_dir String }
  deriving (Debug, Clone, PartialEq, Eq)

export wake_args : &[String] -> Result<WakeOptions, String>
wake_args args =
  mut o = WakeOptions { wait = false, timeout = 1800, fifo = crate::wake::WAKE_FIFO.to_string (), state_dir = .to_string "/var/lib/vdeploy" }
  mut it = args.iter ()
  while it.next () is Some a
    case a.as_str () of
      "--wait" ->
        o.wait := true
      "--timeout" ->
        o.timeout := (positive (it.next ()) "--timeout")?
      "--fifo" ->
        o.fifo := (value (it.next ()) "--fifo")?
      "--state-dir" ->
        o.state_dir := (value (it.next ()) "--state-dir")?
      other ->
        return Err "unknown argument to `vdeploy wake`: #{other}"
  Ok o

#[cfg(test)]
args : &[&str] -> Vec<String>
args xs = xs.iter () |> .map (\s -> s.to_string ()) |> .collect

test "a host is all it needs; the rest has defaults"
  o = parse_args (&args (&["--host", "drakkar"])) |> .expect "options"
  assert_eq! \-> o \-> Options { host = .to_string "drakkar", ...defaults () }
  assert_eq! \-> (o.interval, o.debounce, o.tick, o.url.as_str (), o.branch.as_str ()) \-> (60, 0, 5, DEFAULT_URL, "main")

test "every option is read"
  o = parse_args (&args (&["--host", "h", "--once", "--url", "u", "--branch", "b", "--repo", "/r", "--interval", "5m", "--debounce", "10m", "--tick", "2", "--state-dir", "/s", "--textfile-dir", "/t", "--db", "/db", "--git", "/g", "--nix", "/n", "--dotfiles", "/home/tom/.dotfiles", "--dotfiles-user", "tom", "--dotfiles-group", "users", "--dotfiles-home", "/home/tom"])) |> .expect "options"
  assert_eq! \-> (o.once, o.url.as_str (), o.branch.as_str (), o.repo.as_str (), o.interval, o.debounce, o.tick) \-> (true, "u", "b", "/r", 300, 600, 2)
  assert_eq! \-> (o.state_dir, o.textfile_dir, o.db.as_str (), o.git.as_str (), o.nix.as_str ()) \-> (Some (.to_string "/s"), Some (.to_string "/t"), "/db", "/g", "/n")
  assert_eq! \-> (o.dotfiles, o.dotfiles_user, o.dotfiles_group, o.dotfiles_home) \-> (Some (.to_string "/home/tom/.dotfiles"), Some (.to_string "tom"), Some (.to_string "users"), Some (.to_string "/home/tom"))

test "bad command lines are refused with the reason"
  assert! \-> parse_args (&args (&[])) |> .err |> .map (\e -> e.contains "--host is required") |> .unwrap_or false
  assert_eq! \-> parse_args (&args (&["--host", "h", "--interval", "0"])) \-> Err (.to_string "--interval: not a positive duration: 0")
  assert_eq! \-> parse_args (&args (&["--host", "h", "--debounce", "x"])) \-> Err (.to_string "--debounce: not a duration: x")
  assert_eq! \-> parse_args (&args (&["--host", "h", "--switch"])) \-> Err (.to_string "unknown argument: --switch")
  assert! \-> parse_args (&args (&["--host", "h", "--dotfiles-user", "tom"])) |> .is_err
  assert! \-> parse_args (&args (&["--help"])) |> .map (\o -> o.help) |> .unwrap_or false

test "deploy mode, and the apply subcommand with its options"
  d = parse_args (&args (&["--host", "drakkar", "--mode", "deploy", "--health-window", "3m", "--systemd-run", "/s/systemd-run"])) |> .expect "options"
  assert_eq! \-> (d.deploy, d.apply, d.health_window, d.systemd_run.as_str ()) \-> (true, false, 180, "/s/systemd-run")
  assert_eq! \-> parse_args (&args (&["--host", "h"])) |> .map (\o -> o.deploy) \-> Ok false
  assert_eq! \-> parse_args (&args (&["--host", "h", "--mode", "switch"])) \-> Err (.to_string "--mode: observe or deploy, not switch")
  a = parse_args (&args (&["apply", "--toplevel", "/nix/store/x", "--state-dir", "/s", "--vhealth", "/v", "--profile", "/p", "--gcroot", "/g", "--comin-unit", "c.service"])) |> .expect "apply"
  assert_eq! \-> (a.apply, a.toplevel.clone (), a.vhealth.clone (), a.profile.as_str (), a.gcroot.as_str (), a.comin_unit.as_str ()) \-> (true, Some (.to_string "/nix/store/x"), Some (.to_string "/v"), "/p", "/g", "c.service")
  -- No host needed to apply; a toplevel outside apply is refused.
  assert! \-> parse_args (&args (&["apply"])) |> .is_ok
  assert! \-> parse_args (&args (&["--host", "h", "--toplevel", "/nix/store/x"])) |> .is_err

test "signed commits: a keyring, required or not, and never required without one (GH-221)"
  o = parse_args (&args (&["--host", "h", "--trusted-keys", "/k.gpg", "--require-signed", "--gpgv", "/bin/gpgv"])) |> .expect "options"
  assert_eq! \-> (o.trusted_keys, o.require_signed, o.gpgv.as_str ()) \-> (Some (.to_string "/k.gpg"), true, "/bin/gpgv")
  assert_eq! \-> parse_args (&args (&["--host", "h"])) |> .map (\d -> (d.trusted_keys, d.require_signed)) \-> Ok ((None, false))
  assert! \-> parse_args (&args (&["--host", "h", "--require-signed"])) |> .err |> .map (\e -> e.contains "needs --trusted-keys") |> .unwrap_or false

test "durations"
  assert_eq! \-> (parse_duration "0", parse_duration "90", parse_duration "2m", parse_duration "1h", parse_duration "1d", parse_duration "1w") \-> (Some 0, Some 90, Some 120, Some 3600, Some 86400, None)

test "vdeploy wake: defaults, every option, and refusals"
  d = wake_args (&args (&[])) |> .expect "wake"
  assert_eq! \-> d \-> WakeOptions { wait = false, timeout = 1800, fifo = .to_string "/run/vdeploy/wake", state_dir = .to_string "/var/lib/vdeploy" }
  o = wake_args (&args (&["--wait", "--timeout", "5m", "--fifo", "/f", "--state-dir", "/s"])) |> .expect "wake"
  assert_eq! \-> (o.wait, o.timeout, o.fifo.as_str (), o.state_dir.as_str ()) \-> (true, 300, "/f", "/s")
  assert! \-> wake_args (&args (&["--toplevel", "/x"])) |> .is_err
  assert! \-> wake_args (&args (&["--timeout", "0"])) |> .is_err
  -- The daemon side: the FIFO it reads.
  w = parse_args (&args (&["--host", "h", "--wake-fifo", "/run/vdeploy/wake"])) |> .expect "options"
  assert_eq! \-> w.wake_fifo \-> Some (.to_string "/run/vdeploy/wake")
