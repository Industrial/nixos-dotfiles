-- The program: wire the live capabilities from the options and run the
-- agent (a daemon), or `--once` (one poll and one plan). `main` runs it under
-- id_effect_cli's `run_main`: exit 0, 1 on a usage error or a failed
-- `--once`, 101 on a bug, 130 on Ctrl-C (systemd's stop is SIGINT, and the
-- fibers are interrupted with their finalizers).

import id_effect::{Effect, HNil, effect, fail}
import crate::agent::{Settings, daemon, once}
import crate::caps::{Caps, Wiring, live}
import crate::cli::{Options, USAGE, parse_args}
import crate::common::DeployError
import crate::common::DeployError::Usage
import crate::dotfiles::Dotfiles
import crate::watch::quiet_polls_of
import std::sync::Arc
import crate::apply::{Apply, LiveSystem, SystemTool, accepted, apply}
import crate::takeover::LiveDeployer

-- The user's checkout, when vdeploy manages one.
export checkout_of : &Options -> Option<Dotfiles>
checkout_of o =
  o.dotfiles |> .as_ref |> .map (\p -> Dotfiles { path = p.clone (), url = o.url.clone (), branch = o.branch.clone (), user = o.dotfiles_user.clone (), group = o.dotfiles_group.clone (), home = o.dotfiles_home.clone (), git = o.git.clone () })

-- The ledger directory: the daemon's state directory, as the apply unit's.
export state_dir_of : &Options -> String
state_dir_of o = o.state_dir.clone () |> .unwrap_or_else (\-> .to_string "/var/lib/vdeploy")

-- The options the daemon hands on to `vdeploy apply`.
export apply_args_of : &Options -> Vec<String>
apply_args_of o =
  mut a = Vec::new () : Vec<String>
  for kv in [("--state-dir", state_dir_of o), ("--health-window", "#{o.health_window}s"), ("--health-every", "#{o.health_every}s"), ("--profile", o.profile.clone ()), ("--gcroot", o.gcroot.clone ()), ("--nix-env", o.nix_env.clone ()), ("--nix-store", o.nix_store.clone ()), ("--systemctl", o.systemctl.clone ()), ("--comin-unit", o.comin_unit.clone ())]
    a.push (kv.0.to_string ())
    a.push (kv.1)
  if &o.textfile_dir is Some t
    a.push (.to_string "--textfile-dir")
    a.push (t.clone ())
  if &o.vhealth is Some v
    a.push (.to_string "--vhealth")
    a.push (v.clone ())
  if &o.health_as is Some u
    a.push (.to_string "--health-as")
    a.push (u.clone ())
    a.push (.to_string "--setpriv")
    a.push (o.setpriv.clone ())
  a

-- This binary, for the apply unit (a store path, so it outlives a switch).
self_exe : String
self_exe = std::env::current_exe () |> .map (\p -> p.to_string_lossy () |> .to_string) |> .unwrap_or_else (\_ -> .to_string "vdeploy")

export deployer_of : &Options -> LiveDeployer
deployer_of o = LiveDeployer { systemd_run = o.systemd_run.clone (), systemctl = o.systemctl.clone (), program = self_exe (), args = apply_args_of o, state_dir = state_dir_of o, comin_unit = o.comin_unit.clone (), unit = .to_string "vdeploy-apply" }

export caps_of : &Options -> Caps
caps_of o = live (Wiring { git = o.git.clone (), nix = o.nix.clone (), repo = o.repo.clone (), url = o.url.clone (), branch = o.branch.clone (), host = o.host.clone (), db = o.db.clone (), checkout = checkout_of o, deployer = deployer_of o })

export settings_of : &Options -> Settings
settings_of o = Settings { host = o.host.clone (), interval = o.interval, quiet_polls = quiet_polls_of o.debounce o.interval, tick = o.tick, textfile_dir = o.textfile_dir.clone (), state_dir = o.state_dir.clone (), dotfiles = o.dotfiles.clone () |> .unwrap_or_default, deploy = o.deploy }

-- The live host for `vdeploy apply`.
export system_of : &Options -> LiveSystem
system_of o = LiveSystem { current = .to_string "/run/current-system", profile = o.profile.clone (), gcroot = o.gcroot.clone (), nix_env = o.nix_env.clone (), nix_store = o.nix_store.clone (), systemctl = o.systemctl.clone (), comin_unit = o.comin_unit.clone (), vhealth = o.vhealth.clone (), window = o.health_window, every = o.health_every, health_as = o.health_as.clone (), setpriv = o.setpriv.clone () }

export apply_of : &Options -> Apply
apply_of o = Apply { toplevel = o.toplevel.clone (), state_dir = state_dir_of o, textfile_dir = o.textfile_dir.clone () }

-- `vdeploy apply`: the transaction, then its verdict as the exit code.
applied : Options -> Effect<(), DeployError, HNil>
applied o =
  sys = SystemTool (Arc::new (system_of (&o)))
  apply sys (apply_of (&o)) |> .flat_map (\outcome -> accepted outcome)

-- The program for parsed options (or the usage error).
export program : Result<Options, String> -> Effect<(), DeployError, HNil>
program parsed =
  case parsed of
    Err why -> fail (Usage ("#{why}\n#{USAGE}"))
    Ok o -> if o.apply
      applied o
    else if o.once
      once (caps_of (&o)) (settings_of (&o))
    else
      daemon (caps_of (&o)) (settings_of (&o)) |> .widen

-- On a fiber of the runtime's executor (as rust/tools/vverify's app.vlt):
-- `run_main` polls its root outside the executor's context, so the program
-- runs as the root's child; an interrupt reaches it and every fiber under it.
supervised : Effect<(), DeployError, HNil> -> Effect<(), DeployError, HNil>
supervised eff =
  effect!
    let child = ~eff.fork();
    ~child.join::<HNil>()

-- The process.
export main_code : std::process::ExitCode
main_code =
  args = std::env::args () |> .skip 1 |> .collect : Vec<String>
  parsed = parse_args (&args)
  if parsed |> .as_ref |> .map (\o -> o.help) |> .unwrap_or false
    println! \-> "#{USAGE}"
    std::process::ExitCode::SUCCESS
  else
    id_effect_cli::run_main (supervised (program parsed)) HNil (id_effect_cli::RunMainConfig::default ())

test "a usage error carries the usage line"
  exit = id_effect::testing::run_test (program (Err (.to_string "unknown argument: -x")))
  err = exit |> .into_result |> .err |> .and_then (\c -> c.fail_option ()) |> .map (\e -> e.to_string ())
  assert! \-> err |> .map (\e -> e.contains USAGE && e.contains "-x") |> .unwrap_or false

test "the debounce becomes whole polls, and the checkout is the user's"
  o = parse_args (&[.to_string "--host", .to_string "mimir", .to_string "--interval", .to_string "1m", .to_string "--debounce", .to_string "10m", .to_string "--dotfiles", .to_string "/home/tom/.dotfiles", .to_string "--dotfiles-user", .to_string "tom"]) |> .expect "options"
  assert_eq! \-> (settings_of (&o)).quiet_polls \-> 10
  d = checkout_of (&o) |> .expect "checkout"
  assert_eq! \-> (d.path.as_str (), d.user, d.url.as_str ()) \-> ("/home/tom/.dotfiles", Some (.to_string "tom"), crate::cli::DEFAULT_URL)
  assert_eq! \-> checkout_of (&crate::cli::Options { host = .to_string "h", ...crate::cli::defaults () }) \-> None

test "the daemon hands its ledger, health and host options to the apply unit"
  o = parse_args (&[.to_string "--host", .to_string "h", .to_string "--mode", .to_string "deploy", .to_string "--state-dir", .to_string "/s", .to_string "--textfile-dir", .to_string "/t", .to_string "--health-window", .to_string "90", .to_string "--vhealth", .to_string "/v"]) |> .expect "options"
  a = apply_args_of (&o)
  for pair in [["--state-dir", "/s"], ["--health-window", "90s"], ["--textfile-dir", "/t"], ["--vhealth", "/v"], ["--profile", "/nix/var/nix/profiles/system"], ["--comin-unit", "comin.service"]]
    i = a.iter () |> .position (\x -> x == pair[0]) |> .expect "flag"
    assert_eq! \-> a[i + 1].as_str () \-> pair[1]
  -- What the daemon passes, `vdeploy apply` reads back.
  mut back = .to_vec ([.to_string "apply"]) : Vec<String>
  back.extend (a.iter () |> .cloned)
  parsed = parse_args (&back) |> .expect "apply options"
  assert_eq! \-> (parsed.apply, parsed.health_window, (apply_of (&parsed)).state_dir) \-> (true, 90, .to_string "/s")
  assert! \-> (settings_of (&o)).deploy

test "--once against a repository that does not exist fails, with exit code 1"
  o = parse_args (&[.to_string "--host", .to_string "h", .to_string "--once", .to_string "--url", .to_string "/nonexistent/vdeploy-origin", .to_string "--repo", .to_string "/nonexistent/vdeploy-repo"]) |> .expect "options"
  exit = id_effect::testing::run_test (program (Ok o))
  assert! \-> exit |> .into_result |> .is_err
