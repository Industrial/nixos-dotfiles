-- The user's own checkout (`~/.dotfiles`), fast-forwarded to main.
--
-- Each host's nushell config symlinks into that checkout, and comin never
-- updates it: a stale one breaks the nu login shell, and with it GDM. vdeploy
-- keeps it on main, as the user, and only ever by fast-forward:
--
--   git fetch --no-recurse-submodules <url> main
--   git merge --ff-only FETCH_HEAD
--
-- It refuses, and reports why, when the checkout is not on main, has tracked
-- changes (untracked files and submodule state do not count: a fast-forward
-- touches neither), is ahead of main, or has diverged from it. Already at the
-- head vdeploy just fetched is up to date without touching the network.
--
-- The commands run as the user through `setpriv` (no PAM, no shell) when
-- vdeploy runs as root; the files a merge writes are the user's. Every git
-- call is `--no-optional-locks`: polling a checkout someone works in must not
-- take its index lock.

import std::path::Path
import crate::common::{Cmd, asked, cmd, first_line, run}

-- Where the checkout is, where main comes from, and whom to run git as.
export data Dotfiles
  { export path String
  , export url String
  , export branch String
  , export user Option<String>
  , export group Option<String>
  , export home Option<String>
  , export git String
  }
  deriving (Debug, Clone, PartialEq, Eq)

-- What became of the checkout on one poll.
export data Checkout
  = Disabled
  | Missing String
  | WrongBranch String
  | Dirty usize
  | UpToDate String
  | FastForwarded String String
  | Ahead String
  | Diverged String String
  | Failed String
  deriving (Debug, Clone, PartialEq, Eq)

-- Every state's metric label, in a fixed order.
export const STATES : [&str; 9] = ["disabled", "missing", "wrong-branch", "dirty", "up-to-date", "fast-forwarded", "ahead", "diverged", "failed"]

export state_name : &Checkout -> &'static str
state_name c =
  case c of
    Checkout::Disabled -> "disabled"
    Checkout::Missing _ -> "missing"
    Checkout::WrongBranch _ -> "wrong-branch"
    Checkout::Dirty _ -> "dirty"
    Checkout::UpToDate _ -> "up-to-date"
    Checkout::FastForwarded _ _ -> "fast-forwarded"
    Checkout::Ahead _ -> "ahead"
    Checkout::Diverged _ _ -> "diverged"
    Checkout::Failed _ -> "failed"

short : &str -> String
short sha = sha.chars () |> .take 9 |> .collect

-- One line for the journal.
export describe : &str -> &str -> &Checkout -> String
describe path branch c =
  case c of
    Checkout::Disabled -> .to_string "dotfiles: not managed"
    Checkout::Missing p -> "dotfiles: #{p} is not a git checkout, nothing to fast-forward"
    Checkout::WrongBranch b -> "dotfiles: #{path} is on #{b}, not #{branch}: refusing to fast-forward"
    Checkout::Dirty n -> "dotfiles: #{path} has #{n} changed tracked file(s): refusing to fast-forward"
    Checkout::UpToDate sha -> "dotfiles: #{path} is up to date at #{short sha}"
    Checkout::FastForwarded old new -> "dotfiles: #{path} fast-forwarded #{short old} -> #{short new}"
    Checkout::Ahead sha -> "dotfiles: #{path} is ahead of #{branch} at #{short sha}: refusing to fast-forward"
    Checkout::Diverged local remote -> "dotfiles: #{path} (#{short local}) has diverged from #{branch} (#{short remote}): refusing to fast-forward"
    Checkout::Failed why -> "dotfiles: #{path}: #{why}"

-- The git command in the checkout, as the user when one is set.
export git_cmd : &Dotfiles -> &[&str] -> Cmd
git_cmd d args =
  mut all = Vec::new () : Vec<String>
  case &d.user of
    Some u ->
      all.push (.to_string "--reuid")
      all.push (u.clone ())
      all.push (.to_string "--regid")
      all.push (d.group.clone () |> .unwrap_or_else (\-> .to_string "users"))
      all.push (.to_string "--init-groups")
      all.push (.to_string "env")
      all.push ("HOME=#{d.home.clone ().unwrap_or_else (\-> home_of (&d.path))}")
      all.push (d.git.clone ())
    None ->
      ()
  -- The checkout may be someone's working tree: never take the index lock just to
  -- look (`git status` would otherwise refresh and rewrite the index).
  all.push (.to_string "--no-optional-locks")
  all.push (.to_string "-C")
  all.push (d.path.clone ())
  for a in args
    all.push (a.to_string ())
  program = if d.user.is_some ()
    "setpriv"
  else
    d.git.as_str ()
  cmd program all

-- The checkout's parent directory: `~/.dotfiles` is in the user's home.
export home_of : &str -> String
home_of path = Path::new path |> .parent |> .map (\p -> p.to_string_lossy () |> .to_string) |> .unwrap_or_else (\-> .to_string "/")

git : &Dotfiles -> &[&str] -> Result<String, String>
git d args = run (&git_cmd d args) |> .map (\r -> r.stdout)

-- Fast-forward the checkout to main, whose tip is `head` (as vdeploy's own
-- fetch saw it), or say why not.
export fast_forward : &Dotfiles -> &str -> Checkout
fast_forward d head =
  case attempt d head of
    Ok c -> c
    Err e -> Checkout::Failed e

attempt : &Dotfiles -> &str -> Result<Checkout, String>
attempt d head =
  if !(Path::new (&d.path) |> .join ".git" |> .exists)
    return Ok (Checkout::Missing (d.path.clone ()))
  branch = first_line (&(git d (&["rev-parse", "--abbrev-ref", "HEAD"]))?)
  if branch != d.branch
    return Ok (Checkout::WrongBranch branch)
  status = (git d (&["status", "--porcelain", "--untracked-files=no", "--ignore-submodules=all"]))?
  dirty = status.lines () |> .filter (\l -> !(l.trim ().is_empty ())) |> .count
  if dirty > 0
    return Ok (Checkout::Dirty dirty)
  local = first_line (&(git d (&["rev-parse", "HEAD"]))?)
  if local == head
    return Ok (Checkout::UpToDate local)
  (git d (&["fetch", "--no-recurse-submodules", "--quiet", d.url.as_str (), d.branch.as_str ()]))?
  fetched = first_line (&(git d (&["rev-parse", "FETCH_HEAD"]))?)
  if fetched == local
    return Ok (Checkout::UpToDate local)
  behind = (asked (&git_cmd d (&["merge-base", "--is-ancestor", "HEAD", "FETCH_HEAD"])))?
  if behind
    (git d (&["merge", "--ff-only", "--quiet", "FETCH_HEAD"]))?
    Ok (Checkout::FastForwarded local fetched)
  else
    ahead = (asked (&git_cmd d (&["merge-base", "--is-ancestor", "FETCH_HEAD", "HEAD"])))?
    if ahead
      Ok (Checkout::Ahead local)
    else
      Ok (Checkout::Diverged local fetched)

-- Tests run real git on scratch repositories.
#[cfg(test)]
sh : &str -> &str -> String
sh dir script =
  mut c = cmd "sh" (crate::common::strs (&["-c", script]))
  c.cwd := Some (dir.to_string ())
  c.env.push ((.to_string "GIT_AUTHOR_NAME", .to_string "t"))
  c.env.push ((.to_string "GIT_AUTHOR_EMAIL", .to_string "t@t"))
  c.env.push ((.to_string "GIT_COMMITTER_NAME", .to_string "t"))
  c.env.push ((.to_string "GIT_COMMITTER_EMAIL", .to_string "t@t"))
  ran = run (&c) |> .expect "the test's shell script runs"
  ran.stdout

-- An origin with one commit and a clone of it, under a fresh directory.
#[cfg(test)]
scratch : &str -> (String, Dotfiles)
scratch name =
  root = std::env::temp_dir () |> .join ("vdeploy-dotfiles-#{name}-#{std::process::id ()}") |> .to_string_lossy |> .to_string
  std::fs::remove_dir_all (&root) |> .ok
  std::fs::create_dir_all (&root) |> .expect "scratch root"
  sh (&root) "git init -q -b main origin && cd origin && echo 1 > f && git add f && git commit -qm one && cd .. && git clone -q origin checkout"
  d = Dotfiles { path = "#{root}/checkout", url = "#{root}/origin", branch = .to_string "main", user = None, group = None, home = None, git = .to_string "git" }
  (root, d)

#[cfg(test)]
commit_origin : &str -> &str -> String
commit_origin root text =
  sh (&"#{root}/origin") (&"echo #{text} > f && git commit -qam #{text} && git rev-parse HEAD") |> .trim |> .to_string

test "a clean checkout behind main is fast-forwarded, then up to date"
  (root, d) = scratch "ff"
  old = sh (&d.path) "git rev-parse HEAD" |> .trim |> .to_string
  new = commit_origin (&root) "two"
  assert_eq! \-> fast_forward (&d) (&new) \-> Checkout::FastForwarded (old) (new.clone ())
  assert_eq! \-> sh (&d.path) "cat f" \-> "two\n"
  assert_eq! \-> fast_forward (&d) (&new) \-> Checkout::UpToDate (new)
  std::fs::remove_dir_all (&root) |> .ok

test "a dirty checkout is refused and left alone"
  (root, d) = scratch "dirty"
  old = sh (&d.path) "git rev-parse HEAD" |> .trim |> .to_string
  new = commit_origin (&root) "two"
  sh (&d.path) "echo local > f"
  assert_eq! \-> fast_forward (&d) (&new) \-> Checkout::Dirty 1
  assert_eq! \-> sh (&d.path) "cat f" \-> "local\n"
  -- Untracked files do not block a fast-forward.
  sh (&d.path) "git checkout -q f && touch untracked"
  assert_eq! \-> fast_forward (&d) (&new) \-> Checkout::FastForwarded (old) (new)
  assert_eq! \-> sh (&d.path) "cat f" \-> "two\n"
  std::fs::remove_dir_all (&root) |> .ok

test "a checkout on another branch, ahead, or diverged is refused"
  (root, d) = scratch "refuse"
  sh (&d.path) "git checkout -qb work"
  assert_eq! \-> fast_forward (&d) "x" \-> Checkout::WrongBranch (.to_string "work")
  sh (&d.path) "git checkout -q main && echo mine > f && git commit -qam mine"
  local = sh (&d.path) "git rev-parse HEAD" |> .trim |> .to_string
  assert_eq! \-> fast_forward (&d) "x" \-> Checkout::Ahead (local.clone ())
  remote = commit_origin (&root) "theirs"
  assert_eq! \-> fast_forward (&d) (&remote) \-> Checkout::Diverged (local) (remote)
  std::fs::remove_dir_all (&root) |> .ok

test "no checkout is reported, not an error"
  d = Dotfiles { path = .to_string "/nonexistent/vdeploy/.dotfiles", url = .to_string "u", branch = .to_string "main", user = None, group = None, home = None, git = .to_string "git" }
  assert_eq! \-> fast_forward (&d) "x" \-> Checkout::Missing (.to_string "/nonexistent/vdeploy/.dotfiles")

test "as the user, git runs through setpriv with the user's home"
  d = Dotfiles { path = .to_string "/home/tom/.dotfiles", url = .to_string "u", branch = .to_string "main", user = Some (.to_string "tom"), group = Some (.to_string "users"), home = None, git = .to_string "/bin/git" }
  c = git_cmd (&d) (&["status"])
  assert_eq! \-> c.program \-> "setpriv"
  assert_eq! \-> c.args \-> crate::common::strs (&["--reuid", "tom", "--regid", "users", "--init-groups", "env", "HOME=/home/tom", "/bin/git", "--no-optional-locks", "-C", "/home/tom/.dotfiles", "status"])
  assert_eq! \-> state_name (&Checkout::Dirty 3) \-> "dirty"
