-- The program edge: argv, Nix's file descriptors and settings, the
-- capabilities, and `serve`.
--
--   build-hook = <vbuild> [--nix PATH] [--ssh PATH] [--state-dir DIR]
--                         [--probe-timeout-ms N] [--load-ttl-s N] [--down-ttl-s N]
--
-- Nix appends the verbosity as the last argument.

import std::collections::BTreeSet
import std::sync::Arc
import std::time::Duration
import id_effect::{Effect, HNil, effect, fail, succeed, suspend}
import crate::machines::{Machine, parse_config, read_file}
import crate::run::live
import crate::probe::{SshProbe, Ttl, ssh_options}
import crate::copier::{CopierService, NixCli, RemoteBuildService}
import crate::hook::{ChannelService, Hook, HookError, ProberService, Settings, StdChannel, serve, settings_of}
import crate::wire::read_settings

export data Options
  { export nix String
  , export ssh String
  , export state_dir String
  , export probe_timeout_ms u64
  , export load_ttl_s u64
  , export down_ttl_s u64
  }
  deriving (Debug, Clone, PartialEq)

export defaults : Options
defaults = Options { nix = .to_string "nix", ssh = .to_string "ssh", state_dir = .to_string "/nix/var/nix", probe_timeout_ms = 3000, load_ttl_s = 5, down_ttl_s = 30 }

number : &str -> &str -> Result<u64, String>
number flag v = v.parse () |> .map_err (\_ -> "#{flag} wants a number, not '#{v}'")

-- argv without the program name. Unknown flags are errors; a lone trailing
-- word is Nix's verbosity, and is ignored.
export parse_args : &[String] -> Result<Options, String>
parse_args args =
  mut o = defaults ()
  mut i = 0 : usize
  while i < args.len ()
    flag = args[i].as_str ()
    if flag.starts_with "--"
      v = (args.get (i + 1) |> .ok_or ("#{flag} wants a value"))?
      case flag of
        "--nix" ->
          o.nix := v.clone ()
        "--ssh" ->
          o.ssh := v.clone ()
        "--state-dir" ->
          o.state_dir := v.clone ()
        "--probe-timeout-ms" ->
          o.probe_timeout_ms := (number flag v)?
        "--load-ttl-s" ->
          o.load_ttl_s := (number flag v)?
        "--down-ttl-s" ->
          o.down_ttl_s := (number flag v)?
        _ ->
          (Err ("unknown option #{flag}"))?
      i := i + 2
    else
      i := i + 1
  Ok o

-- The environment `nix copy` and `nix build` run with: they join the probe's
-- ssh master, and find the same ssh first on PATH.
export child_env : &Options -> String -> Vec<(String, String)>
child_env o path =
  opts = ssh_options (&ssh_dir o) "" false |> .join " "
  bin = std::path::Path::new (&o.ssh) |> .parent |> .map (\p -> p.to_string_lossy ().into_owned ()) |> .unwrap_or_default
  full_path = if bin.is_empty ()
    path
  else
    "#{bin}:#{path}"
  .to_vec ([(.to_string "NIX_SSHOPTS", opts), (.to_string "PATH", full_path)])

ssh_dir : &Options -> String
ssh_dir o = "#{o.state_dir}/vbuild/ssh"

rust """
  /// This process's own handle on Nix's build log (fd 4), and fds 4 and 5
  /// closed, so that no child inherits them. Nix sees the end of the build
  /// when every copy of fd 4's pipe end is closed: a child that kept one
  /// (an ssh ControlPersist master lives on for minutes) would hold the build
  /// open. Children that should write the log get it explicitly.
  pub fn adopt_log_fd() -> Option<std::fs::File> {
      use std::os::fd::FromRawFd;
      let log = std::fs::OpenOptions::new().write(true).open("/proc/self/fd/4").ok();
      if log.is_some() {
          for fd in [4, 5] {
              if std::path::Path::new(&format!("/proc/self/fd/{fd}")).exists() {
                  // SAFETY: fds 4 and 5 are the two ends of the builder-output
                  // pipe that Nix's HookInstance dup2'd into this process
                  // before exec. Nothing in this process opened or uses them;
                  // `log` above is a separate descriptor (O_CLOEXEC) for the
                  // same pipe. Owning and dropping them closes them once.
                  drop(unsafe { std::os::fd::OwnedFd::from_raw_fd(fd) });
              }
          }
      }
      log
  }
"""

read_settings_stdin : Result<Settings, HookError>
read_settings_stdin =
  pairs = (read_settings (&mut std::io::stdin ().lock ()) |> .map_err (\e -> HookError::Protocol (e.to_string ())))?
  Ok (settings_of (&pairs))

-- The builders, as Nix itself would read them. A malformed entry is the
-- operator's to fix; build-remote throws, and Nix then builds locally.
machines_of : &Settings -> Result<Vec<Machine>, HookError>
machines_of s =
  systems = BTreeSet::from ([s.this_system.clone ()])
  parse_config (&systems) (&s.builders) (&read_file) |> .map_err (\e -> HookError::Local e)

lifted : given <A: Send + 'static> Result<A, HookError> -> Effect<A, HookError, HNil>
lifted r =
  case r of
    Ok a -> succeed a
    Err e -> fail e

export hook_of : Options -> Settings -> Vec<Machine> -> Option<Arc<std::fs::File>> -> Hook
hook_of o s machines log =
  runner = live (log.clone ())
  probe = SshProbe {
    ssh = o.ssh.clone ()
    , control_dir = ssh_dir (&o)
    , cache_dir = "#{o.state_dir}/vbuild/probe"
    , known_hosts_dir = "#{o.state_dir}/vbuild/known-hosts"
    , timeout = Duration::from_millis o.probe_timeout_ms
    , ttl = Ttl { up = Duration::from_secs o.load_ttl_s, down = Duration::from_secs o.down_ttl_s }
    , runner = runner.clone ()
    }
  path = std::env::var "PATH" |> .unwrap_or_default
  cli = NixCli { nix = o.nix.clone (), env = child_env (&o) path, substitute = s.substitute, runner }
  Hook {
    machines
    , settings = s
    , load_dir = "#{o.state_dir}/current-load"
    , channel = ChannelService (Arc::new StdChannel)
    , prober = ProberService (Arc::new probe)
    , copier = CopierService (Arc::new (cli.clone ()))
    , remote = RemoteBuildService (Arc::new cli)
    , log
    }

-- No builders at all: tell Nix to stop asking, at once (build-remote does
-- the same before reading a request).
start : Options -> Option<Arc<std::fs::File>> -> Settings -> Effect<(), HookError, HNil>
start o log s =
  case machines_of (&s) of
    Err e ->
      eprintln! \-> "vbuild: #{e}"
      say "# decline-permanently\n"
    Ok ms ->
      if ms.is_empty ()
        say "# decline-permanently\n"
      else
        _ = std::fs::create_dir_all (&ssh_dir (&o))
        serve (Arc::new (hook_of o s ms log))

say : &str -> Effect<(), HookError, HNil>
say text =
  eprint! \-> "#{text}"
  succeed (())

export program : Options -> Effect<(), HookError, HNil>
program o = suspend (move \-> begin o)

begin : Options -> Effect<(), HookError, HNil>
begin o =
  log = adopt_log_fd () |> .map Arc::new
  suspend (\-> lifted (read_settings_stdin ())) |> .flat_map (move \s -> start o log s)

-- On a fiber of the runtime's executor: `run_main` polls its root fiber on
-- the calling thread, outside the tokio context the child processes need, so
-- the program runs as the root's child (vcache's `supervised`).
supervised : Options -> Effect<(), HookError, HNil>
supervised o =
  effect!
    let child = ~program(o).fork();
    ~child.join::<HNil>()

usage : String -> Effect<(), HookError, HNil>
usage why = fail (HookError::Protocol ("usage: #{why}"))

export main_code : std::process::ExitCode
main_code =
  args = std::env::args () |> .skip 1 |> .collect : Vec<String>
  eff = case parse_args (&args) of
    Ok o -> supervised o
    Err why -> usage why
  id_effect_cli::run_main eff HNil (id_effect_cli::RunMainConfig::default ())

test "argv: flags, defaults, and Nix's trailing verbosity"
  args = .to_vec ([.to_string "--nix", .to_string "/x/bin/nix", .to_string "--probe-timeout-ms", .to_string "500", .to_string "3"]) : Vec<String>
  o = parse_args (&args) |> .unwrap
  assert_eq! \-> o.nix \-> .to_string "/x/bin/nix"
  assert_eq! \-> o.probe_timeout_ms \-> 500
  assert_eq! \-> o.ssh \-> .to_string "ssh"
  assert_eq! \-> o.state_dir \-> .to_string "/nix/var/nix"

test "argv: an unknown flag or a missing value is refused"
  assert! \-> parse_args (&[.to_string "--frob", .to_string "1"]) |> .is_err
  assert! \-> parse_args (&[.to_string "--nix"]) |> .is_err
  assert! \-> parse_args (&[.to_string "--load-ttl-s", .to_string "soon"]) |> .is_err

test "children join the ssh master and find the same ssh"
  mut o = defaults ()
  o.ssh := .to_string "/o/bin/ssh"
  env = child_env (&o) (.to_string "/usr/bin")
  assert_eq! \-> env[1].1 \-> .to_string "/o/bin:/usr/bin"
  assert! \-> env[0].1.contains "-oControlMaster=no"
  assert! \-> env[0].1.contains "-oControlPath=/nix/var/nix/vbuild/ssh/%C"
