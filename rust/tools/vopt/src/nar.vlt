-- The NAR hash of one regular file or symlink, which is what Nix keys
-- `/nix/store/.links` by (`optimisePath_`: `hashPath(..., NixArchive,
-- SHA256)`, printed nix32 without the algorithm prefix). The serialisation is
-- the one `nix-store --dump` writes (src/libutil/archive.cc):
--
--   str "nix-archive-1" "(" "type" "regular" ["executable" ""] "contents" <file> ")"
--   str "nix-archive-1" "(" "type" "symlink" "target" <target> ")"
--
-- where `str s` is s's length as a little-endian u64, then s, then zero
-- padding to a multiple of 8. A file is executable when its owner may run it.
-- No GC or optimise logic lives here, so a shared store crate can absorb it.

import sha2::{Digest, Sha256}
import std::fs
import std::io::Read
import std::os::unix::fs::PermissionsExt
import std::path::Path

-- Nix's base-32 alphabet (no e, o, u, t).
const NIX32 : &[u8] = b"0123456789abcdfghijklmnpqrsvwxyz"

-- `printHash32`: Nix's base-32, which reads the hash from its last bit to its
-- first, five bits at a time, so a digest's first character comes from its
-- last byte.
export nix32 : &[u8] -> String
nix32 hash =
  bits = hash.len () * 8
  len = (bits - 1) / 5 + 1
  mut out = String::with_capacity len
  for n in (0 .. len).rev ()
    b = n * 5
    i = b / 8
    j = b % 8
    low = u32::from hash[i] >> j
    high = if i + 1 < hash.len ()
      u32::from hash[i + 1] << (8 - j)
    else
      0
    c = (low ^ (high & !low)) & 31
    out.push (char::from NIX32[usize::try_from c |> .unwrap_or 0])
  out

padding : u64 -> usize
padding n = usize::try_from ((8 - n % 8) % 8) |> .unwrap_or 0

-- `str s`: length, bytes, padding.
put : &mut Sha256 -> &[u8] -> ()
put h s =
  n = u64::try_from (s.len ()) |> .unwrap_or 0
  h.update (n.to_le_bytes ())
  h.update s
  h.update (&[0u8; 8][0 .. padding n])
  ()

-- The NAR hash of a regular file or symlink at `path`, nix32.
export nar_hash : &Path -> std::io::Result<String>
nar_hash path =
  m = (fs::symlink_metadata path)?
  mut h = Sha256::new ()
  put (&mut h) b"nix-archive-1"
  put (&mut h) b"("
  put (&mut h) b"type"
  if m.file_type ().is_symlink ()
    target = (fs::read_link path)?
    put (&mut h) b"symlink"
    put (&mut h) b"target"
    put (&mut h) (target.as_os_str ().as_encoded_bytes ())
  else
    put (&mut h) b"regular"
    if m.permissions ().mode () & 0o100 != 0
      put (&mut h) b"executable"
      put (&mut h) b""
    put (&mut h) b"contents"
    (contents (&mut h) path (m.len ()))?
  put (&mut h) b")"
  Ok (nix32 (h.finalize ().as_slice ()))

-- A file's contents as a NAR string, streamed: length, bytes, padding.
contents : &mut Sha256 -> &Path -> u64 -> std::io::Result<()>
contents h path size =
  h.update (size.to_le_bytes ())
  mut file = (fs::File::open path)?
  mut buf = vec![0u8; 1 << 16]
  mut seen = 0 : u64
  mut more = true
  while more
    n = (file.read (&mut buf))?
    if n == 0
      more := false
    else
      h.update (&buf[0 .. n])
      seen += u64::try_from n |> .unwrap_or 0
  h.update (&[0u8; 8][0 .. padding seen])
  Ok ()

test "nix32 matches Nix on known digests"
  -- sha256 of the empty string, as `nix-hash --type sha256 --to-base32` prints it.
  empty = Sha256::digest b""
  assert! \-> nix32 (empty.as_slice ()) == "0mdqa9w1p6cmli6976v4wi0sw9r4p5prkj7lzfd1877wk11c9c73"

test "NAR hashes match nix-hash for a file, an executable, a symlink and an empty file"
  dir = std::env::temp_dir () |> .join "vopt-nar-test"
  _ := fs::remove_dir_all (&dir)
  _ := fs::create_dir_all (&dir)
  _ := fs::write (&(dir.join "plain")) "hello"
  _ := fs::write (&(dir.join "exec")) "#!/bin/sh\necho hi\n"
  _ := fs::set_permissions (&(dir.join "exec")) (fs::Permissions::from_mode 0o755)
  _ := std::os::unix::fs::symlink "../some/target" (&(dir.join "link"))
  _ := fs::write (&(dir.join "empty")) ""
  -- Goldens from `nix-hash --type sha256 --base32` on the same four entries.
  assert! \-> (nar_hash (&(dir.join "plain"))).unwrap () == "0sg9f58l1jj88w6pdrfdpj5x9b1zrwszk84j81zvby36q9whhhqa"
  assert! \-> (nar_hash (&(dir.join "exec"))).unwrap () == "183p8jhjfcpk6kac6hxwp4gzp9brkvkibylz27jfbvgd5kqcq2jy"
  assert! \-> (nar_hash (&(dir.join "link"))).unwrap () == "0plvhin0k6y27b9pjz17xblk6z20ai08f14zbb543i4vgm13phf9"
  assert! \-> (nar_hash (&(dir.join "empty"))).unwrap () == "0ip26j2h11n1kgkz36rl4akv694yz65hr72q4kv4b3lxcbi65b3p"
  _ := fs::remove_dir_all (&dir)
