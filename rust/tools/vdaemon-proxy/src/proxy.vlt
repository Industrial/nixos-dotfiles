-- The proxy: accept each client as a fiber, connect upstream as that
-- client, relay both directions byte for byte, and log what the tap sees.
--
-- Each direction is a stream of chunks read from one socket and folded into
-- the other (Stream::unfold_effect over reads, run_fold_effect over writes).
-- The tap is shown every chunk before it is written on, and its events
-- become log lines. The two directions run as two fibers (zip_par); when the
-- client closes, its direction shuts the daemon's write side and the
-- daemon's direction then ends too. The client fibers are forked into one
-- scope, so a shutdown interrupts and awaits all of them.

import std::sync::{Arc, Mutex}
import std::sync::atomic::{AtomicBool, AtomicU64, Ordering}
import std::time::Duration
import std::time::Instant
import nix_store_core::worker::Op
import crate::answer::{Answer, NativeMode, decide, last_of}
import tokio::io::{AsyncReadExt, AsyncWriteExt}
import tokio::net::{UnixListener, UnixStream}
import tokio::net::unix::{OwnedReadHalf, OwnedWriteHalf}
import id_effect::{Effect, HNil, Never, Schedule, Scope, Stream, fail, from_async, succeed, suspend, zip_par}
import crate::tap::Event::{OpEnded, OpStarted, TapLost}
import crate::tap::{Event, Tap, client_bytes, daemon_bytes, in_reply, new_tap, version}
import crate::record::{Peer, conformance_line, connect_line, disconnect_line, emit, error_line, lost_line, op_line}
import crate::conform::{Checker, NarJob, Outcome, Watch, check_nar, count_native, new_watch, on_op_end, on_reply_bytes, on_request, write_metrics}
import crate::policy::{PolicyHook, verdict_text}
import crate::upstream::connect_as

export errors ProxyError
  from std::io::Error as Io  "#{0}"
  Upstream String            "connecting to the daemon: #{0}"

-- Bytes per read.
const CHUNK : usize = 65536

-- What the proxy needs besides the listener.
-- `checker` is conformance mode (crate::conform), `native` native answering
-- (crate::answer), each when it is on.
export data Settings { export upstream String, export policy PolicyHook, export checker Option<Arc<Checker>>, export native Option<Arc<NativeMode>> }

instance Clone Settings
  clone : &self -> Self
  clone self = Settings { upstream = self.upstream.clone (), policy = self.policy.clone (), checker = self.checker.clone (), native = self.native.clone () }

-- A write half shared by the direction that relays into it and, for the
-- client's, by native answers.
export type Out = Arc<tokio::sync::Mutex<OwnedWriteHalf>>

export data Side = FromClient | FromDaemon
  deriving (Debug, Clone, Copy, PartialEq, Eq)

-- One client connection: who it is, its tap, and the policy's verdict on
-- the op in flight.
export data Session { id u64, peer Peer, policy PolicyHook, tap Mutex<Tap>, verdict Mutex<String>, checker Option<Arc<Checker>>, watch Mutex<Watch>, native Option<Arc<NativeMode>>, answered AtomicBool }

lifted : given <A: Send + 'static> Result<A, ProxyError> -> Effect<A, ProxyError, HNil>
lifted r =
  case r of
    Ok a -> succeed a
    Err e -> fail e

-- Show the tap a chunk and log what it makes of it. In conformance mode the
-- checker is shown it too; what it leaves to do after the chunk is written
-- on (a NAR to compare) is returned.
--
-- In native mode (crate::answer) an op the proxy answers itself comes back
-- as `answer`: those bytes go to the client, and the chunk (the whole
-- request) does not go to the daemon. The tap is shown the answer's LAST, so
-- the op ends and is logged as any other.
export data Step { jobs Vec<NarJob>, answer Option<Answer> }

observe : &Session -> Side -> &[u8] -> Step
observe s side bytes =
  now = Instant::now ()
  mut tap = s.tap.lock () |> .unwrap_or_else (\p -> p.into_inner ())
  replying = in_reply (&tap)
  mut events = case side of
    FromClient -> client_bytes (&mut tap) bytes now
    FromDaemon -> daemon_bytes (&mut tap) bytes now
  mut answer = None : Option<Answer>
  if side == FromClient && &s.native is Some m
    v = version (&tap) |> .unwrap_or 0
    mut started = None : Option<Op>
    for e in &events
      if e is OpStarted req
        answer := decide m v req (&tap.request_bytes) bytes
        started := req.op
    if &answer is Some a
      ended = daemon_bytes (&mut tap) (&last_of a) now
      events.extend ended
      s.answered.store true Ordering::SeqCst
      if started is Some op
        count_native (&m.store) op
  mut outcomes = Vec::new () : Vec<Outcome>
  if answer.is_none () && &s.checker is Some c
    mut w = s.watch.lock () |> .unwrap_or_else (\p -> p.into_inner ())
    v = version (&tap) |> .unwrap_or 0
    if side == FromDaemon && replying
      outcomes.push (on_reply_bytes c (&mut w) bytes)
    for e in &events
      case e of
        OpStarted req -> on_request c (&mut w) v req (&tap.request_bytes)
        OpEnded f -> outcomes.push (on_op_end c (&mut w) (f.error.clone ()) (&tap.reply_head))
        _ -> ()
  drop tap
  for e in events
    log_event s e
  mut jobs = Vec::new () : Vec<NarJob>
  for o in outcomes
    case o of
      Outcome::Differs fields -> report_diff s fields
      Outcome::NarDone job -> jobs.push job
      Outcome::Quiet -> ()
  Step { jobs, answer }

-- Who answered the op that just ended (and back to the daemon for the next).
take_answered : &Session -> &str
take_answered s =
  if s.answered.swap false Ordering::SeqCst
    "native"
  else
    "daemon"

-- A difference: one line now, and the counters' textfile at once.
report_diff : &Session -> serde_json::Map<String, serde_json::Value> -> ()
report_diff s fields =
  emit (conformance_line s.id (&s.peer) fields)
  if &s.checker is Some c
    if write_metrics c is Err e
      eprintln! \-> "vdaemon-proxy: writing the conformance metrics: #{e}"
  ()

-- Compare the NARs the daemon finished sending, on a fiber of their own: the
-- native side reads the whole path again, and the relay must not wait.
nar_checks : Arc<Session> -> Vec<NarJob> -> Effect<(), ProxyError, HNil>
nar_checks s jobs =
  nar_work s jobs |> .fork_daemon |> .map (\_ -> ()) |> .widen

nar_work : Arc<Session> -> Vec<NarJob> -> Effect<(), Never, HNil>
nar_work s jobs = suspend (move \-> nar_now s jobs)

nar_now : Arc<Session> -> Vec<NarJob> -> Effect<(), Never, HNil>
nar_now s jobs =
  run_nar_checks s jobs
  succeed (())

run_nar_checks : Arc<Session> -> Vec<NarJob> -> ()
run_nar_checks s jobs =
  if &s.checker is Some c
    for job in &jobs
      if check_nar c job is Some fields
        report_diff (&s) fields
  ()

log_event : &Session -> Event -> ()
log_event s e =
  case e of
    OpStarted req ->
      verdict = s.policy.0.decide (&s.peer) (&req)
      mut held = s.verdict.lock () |> .unwrap_or_else (\p -> p.into_inner ())
      held.clear ()
      held.push_str (&verdict_text (&verdict))
    OpEnded f ->
      verdict = s.verdict.lock () |> .map (\v -> v.clone ()) |> .unwrap_or_default
      emit (op_line s.id (&s.peer) (&f) (&verdict) (take_answered s))
    TapLost why -> emit (lost_line s.id (&s.peer) (&why))
  ()

read_chunk : async OwnedReadHalf -> Result<Option<(Vec<u8>, OwnedReadHalf)>, ProxyError>
read_chunk reader =
  mut r = reader
  mut buf = Vec::new () : Vec<u8>
  buf.resize CHUNK 0
  n <- r.read (&mut buf)
  k = n?
  if k == 0
    return Ok None
  buf.truncate k
  Ok (Some ((buf, r)))

read_step : OwnedReadHalf -> Effect<Option<(Vec<u8>, OwnedReadHalf)>, ProxyError, HNil>
read_step r = from_async (move \-> read_chunk r)

write_chunk : async Out -> Vec<u8> -> Result<Out, ProxyError>
write_chunk out bytes =
  written <- write_locked (Arc::clone (&out)) bytes
  written?
  Ok out

write_locked : async Out -> Vec<u8> -> Result<(), ProxyError>
write_locked out bytes =
  held <- out.lock_owned ()
  mut w = held
  r <- w.write_all (&bytes)
  r?
  Ok ()

shutdown : async Out -> Result<(), ProxyError>
shutdown out =
  held <- out.lock_owned ()
  mut w = held
  _r <- w.shutdown ()
  Ok ()

-- One chunk: observed, then written on; or, answered natively, the answer
-- written back to the client instead.
forward : Arc<Session> -> Side -> Out -> Out -> Vec<u8> -> Effect<Out, ProxyError, HNil>
forward s side out back bytes =
  suspend (move \-> forward_now s side out back bytes)

forward_now : Arc<Session> -> Side -> Out -> Out -> Vec<u8> -> Effect<Out, ProxyError, HNil>
forward_now s side out back bytes =
  step = observe (&s) side (&bytes)
  case step.answer of
    Some (Answer::Bytes reply) -> from_async (move \-> write_locked back reply) |> .map (move \_ -> out)
    Some (Answer::NarAfter last path) ->
      first = Arc::clone (&back)
      from_async (move \-> write_locked first last) |> .flat_map (move \_ -> send_nar back path) |> .map (move \_ -> out)
    None ->
      jobs = step.jobs
      written = from_async (move \-> write_chunk out bytes)
      if jobs.is_empty ()
        written
      else
        written |> .flat_map (move \w2 -> nar_checks s jobs |> .map (move \_ -> w2))

-- NarFromPath answered natively: the archive of the path, chunk by chunk
-- (nix_store_core::nar::stream, one chunk of memory), to the client.
send_nar : Out -> String -> Effect<(), ProxyError, HNil>
send_nar back path =
  nix_store_core::nar::stream (std::path::PathBuf::from path) |> .map_err ProxyError::Io |> .run_for_each_effect (move \chunk -> nar_chunk (Arc::clone (&back)) chunk)

nar_chunk : Out -> bytes::Bytes -> Effect<(), ProxyError, HNil>
nar_chunk back chunk = from_async (move \-> write_locked back (chunk.to_vec ()))

-- One direction, until its reader ends; then the other side's write half
-- is shut, so the end of the stream reaches it. `back` is the reader's own
-- side, for native answers.
export pump : Arc<Session> -> Side -> OwnedReadHalf -> Out -> Out -> Effect<(), ProxyError, HNil>
pump s side r out back =
  Stream::unfold_effect r read_step |> .run_fold_effect out (move \acc bytes -> forward (Arc::clone (&s)) side acc (Arc::clone (&back)) bytes) |> .flat_map (\w -> from_async (move \-> shutdown w))

peer_of : &UnixStream -> Peer
peer_of stream =
  case stream.peer_cred () of
    Ok c -> Peer { uid = c.uid (), gid = c.gid (), pid = c.pid () |> .unwrap_or 0 }
    Err _ -> Peer { uid = u32::MAX, gid = u32::MAX, pid = 0 }

-- The daemon, connected as `peer` (crate::upstream), as a tokio stream.
connect_upstream : Peer -> String -> Result<UnixStream, ProxyError>
connect_upstream peer path =
  std = (connect_as (&peer) (&path) |> .map_err (\e -> Upstream ("#{path}: #{e}")))?
  (std.set_nonblocking true)?
  UnixStream::from_std std |> .map_err Io

relay : Arc<Session> -> UnixStream -> UnixStream -> Effect<(), ProxyError, HNil>
relay s client daemon =
  (cr, cw) = client.into_split ()
  (dr, dw) = daemon.into_split ()
  to_client = Arc::new (tokio::sync::Mutex::new cw) : Out
  to_daemon = Arc::new (tokio::sync::Mutex::new dw) : Out
  zip_par (pump (Arc::clone (&s)) FromClient cr (Arc::clone (&to_daemon)) (Arc::clone (&to_client))) (pump s FromDaemon dr to_client to_daemon) |> .map (\_ -> ())

-- One client, start to end. Failures are logged here; nothing escapes.
export serve_client : UnixStream -> u64 -> Settings -> Effect<(), Never, HNil>
serve_client stream id settings =
  peer = peer_of (&stream)
  emit (connect_line id (&peer))
  s = Arc::new (Session { id, peer, policy = settings.policy.clone (), tap = Mutex::new (new_tap ()), verdict = Mutex::new (String::new ()), checker = settings.checker.clone (), watch = Mutex::new (new_watch ()), native = settings.native.clone (), answered = AtomicBool::new false })
  upstream = settings.upstream.clone ()
  ended = Arc::clone (&s)
  failed = Arc::clone (&s)
  suspend (move \-> lifted (connect_upstream peer upstream)) |> .flat_map (move \daemon -> relay s stream daemon) |> .catch (move \e -> log_failure failed e) |> .map (move \_ -> log_end ended)

log_failure : Arc<Session> -> ProxyError -> Effect<(), Never, HNil>
log_failure s e =
  emit (error_line s.id (&s.peer) (&e.to_string ()))
  succeed (())

log_end : Arc<Session> -> ()
log_end s =
  ops = s.tap.lock () |> .map (\t -> t.ops) |> .unwrap_or 0
  emit (disconnect_line s.id (&s.peer) ops)
  ()

accept_next : async (Arc<UnixListener>, u64) -> Result<Option<((UnixStream, u64), (Arc<UnixListener>, u64))>, ProxyError>
accept_next state =
  (listener, id) = state
  r <- listener.accept ()
  (stream, _addr) = r?
  Ok (Some (((stream, id), (listener, id + 1))))

accept_step : (Arc<UnixListener>, u64) -> Effect<Option<((UnixStream, u64), (Arc<UnixListener>, u64))>, ProxyError, HNil>
accept_step state = from_async (move \-> accept_next state)

-- A client served, counted while it is open (#224: the drain waits on the count).
left : Arc<AtomicU64> -> Effect<(), Never, HNil>
left active =
  active.fetch_sub 1 Ordering::SeqCst
  succeed (())

spawn : &Scope -> (UnixStream, u64) -> Settings -> Arc<AtomicU64> -> Effect<(), ProxyError, HNil>
spawn scope accepted settings active =
  (stream, id) = accepted
  active.fetch_add 1 Ordering::SeqCst
  done = Arc::clone (&active)
  scope.fork_in (serve_client stream id settings |> .ensuring (suspend (move \-> left done))) |> .map (\_ -> ()) |> .widen

-- How long a stop waits for open connections (#224). A vdeploy switch restarts
-- the proxy while builds (vci's, a user's) may be connected: each gets this
-- long to finish before it is closed. The unit's TimeoutStopSec is longer.
export const DRAIN_SECS : u64 = 25

rust """
  /// Resolves at the first SIGTERM (systemd's stop). Installed when the server
  /// starts accepting; before that, SIGTERM keeps its default action (nothing is
  /// in flight yet).
  pub fn terminated() -> Effect<(), ProxyError, HNil> {
      id_effect::from_async(move || async move {
          let mut term = tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())?;
          term.recv().await;
          Ok(())
      })
  }
"""

idle_check : Arc<AtomicU64> -> Effect<(), u64, HNil>
idle_check active =
  suspend (move \-> idle_now (active.load Ordering::SeqCst))

idle_now : u64 -> Effect<(), u64, HNil>
idle_now n =
  if n == 0
    succeed (())
  else
    fail n

cut_off : u64 -> Effect<(), Never, HNil>
cut_off n =
  eprintln! \-> "vdaemon-proxy: stop: #{n} connection(s) still open after #{DRAIN_SECS}s; closing them"
  succeed (())

-- The drain: no new client is accepted (systemd keeps the socket listening,
-- so new clients queue for the next start), and the open ones get DRAIN_SECS
-- to finish, looked at every 200 ms. What is still open then is closed.
export drained : Arc<AtomicU64> -> Effect<(), Never, HNil>
drained active =
  n = active.load Ordering::SeqCst
  eprintln! \-> "vdaemon-proxy: stop: no longer accepting; draining #{n} connection(s), up to #{DRAIN_SECS}s"
  looks = Schedule::spaced (Duration::from_millis 200) |> .intersect (Schedule::recurs (DRAIN_SECS * 5))
  Effect::retry (move \-> idle_check (active.clone ())) looks |> .catch cut_off

-- Accept clients until SIGTERM (then drain, and return, so run_main's
-- finalizers run and the exit is 0) or an interrupt, or until accept fails,
-- which ends the program for systemd to restart (the socket stays systemd's).
export serve : UnixListener -> Settings -> Effect<(), ProxyError, HNil>
serve listener settings =
  l = Arc::new listener
  active = Arc::new (AtomicU64::new 0)
  a2 = Arc::clone (&active)
  Effect::scoped (move \scope -> Stream::unfold_effect (l, 1) accept_step |> .run_for_each_effect (move \accepted -> spawn (&scope) accepted (settings.clone ()) (Arc::clone (&active))) |> .race_first (terminated ()) |> .flat_map (move \_ -> drained a2 |> .widen))

test "the drain: no open connection is no wait; a connection left open is closed at the deadline"
  idle = Arc::new (AtomicU64::new 0)
  assert! \-> id_effect::testing::run_test (drained idle) |> .into_result |> .is_ok
  -- One that never ends: the drain gives up after DRAIN_SECS (on the test clock), it does not hang.
  stuck = Arc::new (AtomicU64::new 1)
  assert! \-> id_effect::testing::run_test (drained (Arc::clone (&stuck))) |> .into_result |> .is_ok
  assert_eq! \-> stuck.load Ordering::SeqCst \-> 1

test "a connection is counted while it is served, whatever way it ends"
  active = Arc::new (AtomicU64::new 2)
  assert! \-> id_effect::testing::run_test (left (Arc::clone (&active))) |> .into_result |> .is_ok
  assert_eq! \-> active.load Ordering::SeqCst \-> 1
