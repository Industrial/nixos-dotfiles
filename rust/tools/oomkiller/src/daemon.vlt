-- The oomkiller as an id_effect program: one check (`tick`) over the
-- capabilities in `ports.vlt`, repeated on a fixed Schedule. Nothing here
-- touches the machine, so every path is tested with fakes on virtual time.
-- The decisions are `policy.vlt`'s, and the real capabilities are `live.vlt`'s.


import std::time::Duration
import id_effect::{Effect, Need, Schedule, fail, need, succeed}
import crate::policy::{Line, ProcessInfo, Reading, Tick, journal, pick_victim, threshold_exceeded}
import crate::ports::{DaemonEnv, DaemonError, Kill, Log, Memory, Owner, Processes}

-- Seconds between memory checks. A check only refreshes memory totals (one
-- read of /proc/meminfo); the process table is walked only past the threshold.
-- At 5 seconds a parallel link or a large backtest could take a 61 GiB host
-- from 80% to exhaustion between two checks.
export const INTERVAL_SECS : u64 = 1

reading : Effect<Reading, DaemonError, DaemonEnv>
reading =
  memory : Need<Memory> = need ()
  memory.flat_map (\m -> (m.inner.read ()).widen ().any_env ())

-- SIGKILL the victim. A refused kill is an outcome to report, not a failure
-- of the check.
kill_victim : Reading -> ProcessInfo -> Effect<Tick, DaemonError, DaemonEnv>
kill_victim r victim =
  killer : Need<Kill> = need ()
  pid = victim.pid
  kept = victim.clone ()
  killer.flat_map (move \k -> (((k.inner.kill pid).map (move \_ -> Tick::Killed r victim)).catch (move \e -> succeed (Tick::KillFailed r kept e.reason))).any_env ())

act : Reading -> Option<ProcessInfo> -> Effect<Tick, DaemonError, DaemonEnv>
act r victim = case victim of
  None -> succeed (Tick::NoVictim r)
  Some p -> kill_victim r p

-- Past the threshold: walk the process table and act on the largest process
-- the owner has.
reap : Reading -> Effect<Tick, DaemonError, DaemonEnv>
reap r =
  owner : Need<Owner> = need ()
  owner.flat_map (move \o -> candidates o.uid r)

candidates : u32 -> Reading -> Effect<Tick, DaemonError, DaemonEnv>
candidates uid r =
  table : Need<Processes> = need ()
  listed = table.flat_map (\t -> (t.inner.snapshot ()).widen ().any_env ())
  listed.flat_map (move \ps -> act r (pick_victim ps uid))

decide : Reading -> Effect<Tick, DaemonError, DaemonEnv>
decide r = case threshold_exceeded r.used r.total of
  Err e -> fail (DaemonError::MemoryUnreadable e)
  Ok exceeded -> if exceeded
    reap r
  else
    succeed Tick::Idle

-- One check. It fails only when the reading is unusable, which ends the daemon.
export tick : Effect<Tick, DaemonError, DaemonEnv>
tick = (reading ()).flat_map decide

write : Vec<Line> -> Effect<(), DaemonError, DaemonEnv>
write lines =
  log : Need<Log> = need ()
  log.flat_map (move \l -> (l.inner.write lines).widen ().any_env ())

-- One check, journalled.
export step : Effect<Tick, DaemonError, DaemonEnv>
step = (tick ()).flat_map (\t -> (write (journal (&t))).map (move \_ -> t))

-- `step`, repeated on `schedule` until a check fails.
export run_on : given <Out: Send + 'static> Schedule<Out, Tick> -> Effect<Out, DaemonError, DaemonEnv>
run_on schedule = Effect::repeat crate::daemon::step schedule

-- Journal the reason before failing, as the daemon always has.
fail_loudly : DaemonError -> Effect<u64, DaemonError, DaemonEnv>
fail_loudly e =
  line = Line::Warn (e.to_string ())
  (write (.to_vec ([line]))).flat_map (move \_ -> fail e)

-- The daemon: a check every INTERVAL_SECS, forever, until one fails.
export daemon : Effect<u64, DaemonError, DaemonEnv>
daemon = (run_on (Schedule::spaced (Duration::from_secs INTERVAL_SECS))).catch fail_loudly

-- Fakes: values behind the same traits, recording what they were asked to do.

#[cfg(test)]
import std::sync::{Arc, Mutex, PoisonError}
#[cfg(test)]
import id_effect::{Exit, assert_exit_success, expect_exit_failure, run_test, sync}
#[cfg(test)]
import crate::ports::{Journal, KillError, Killer, MemoryProbe, ProcessTable, env}
#[cfg(test)]
import id_effect::Never

#[cfg(test)]
data FixedMemory { reading Reading }

#[cfg(test)]
instance MemoryProbe FixedMemory
  read : &self -> Effect<Reading, Never>
  read self = succeed self.reading

#[cfg(test)]
data FixedTable { processes Vec<ProcessInfo> }

#[cfg(test)]
instance ProcessTable FixedTable
  snapshot : &self -> Effect<Vec<ProcessInfo>, Never>
  snapshot self = succeed (self.processes.clone ())

#[cfg(test)]
data RecordingKiller { killed Arc<Mutex<Vec<u32>>>, refuse bool }

#[cfg(test)]
instance Killer RecordingKiller
  kill : &self -> u32 -> Effect<(), KillError>
  kill self pid =
    killed = Arc::clone (&self.killed)
    refuse = self.refuse
    if refuse
      fail (KillError { reason = .to_string "denied" })
    else
      sync (move \-> (killed.lock ().unwrap_or_else PoisonError::into_inner).push pid)

#[cfg(test)]
data RecordingJournal { lines Arc<Mutex<Vec<Line>>> }

#[cfg(test)]
instance Journal RecordingJournal
  write : &self -> Vec<Line> -> Effect<(), Never>
  write self lines =
    kept = Arc::clone (&self.lines)
    sync (move \-> (kept.lock ().unwrap_or_else PoisonError::into_inner).extend lines)

#[cfg(test)]
data Fakes { env DaemonEnv, killed Arc<Mutex<Vec<u32>>>, lines Arc<Mutex<Vec<Line>>> }

#[cfg(test)]
fakes : Reading -> Vec<ProcessInfo> -> bool -> Fakes
fakes r processes refuse =
  killed = Arc::new (Mutex::new (Vec::new ()))
  lines = Arc::new (Mutex::new (Vec::new ()))
  memory = Memory { inner = Arc::new (FixedMemory { reading = r }) }
  table = Processes { inner = Arc::new (FixedTable { processes }) }
  killer = Kill { inner = Arc::new (RecordingKiller { killed = Arc::clone (&killed), refuse }) }
  log = Log { inner = Arc::new (RecordingJournal { lines = Arc::clone (&lines) }) }
  Fakes { env = env memory table killer log (Owner { uid = 1000 }), killed, lines }

#[cfg(test)]
killed_of : &Fakes -> Vec<u32>
killed_of f = (f.killed.lock ().unwrap_or_else PoisonError::into_inner).clone ()

#[cfg(test)]
lines_of : &Fakes -> Vec<Line>
lines_of f = (f.lines.lock ().unwrap_or_else PoisonError::into_inner).clone ()

#[cfg(test)]
proc : u32 -> u32 -> u64 -> ProcessInfo
proc pid uid memory = ProcessInfo { pid, uid, memory, name = .to_string "p", cmdline = String::new () }

#[cfg(test)]
crowd : Vec<ProcessInfo>
crowd = .to_vec ([proc 1 0 9000, proc 2 1000 300, proc 3 1000 20, proc 4 1001 8000])

#[cfg(test)]
full : Reading
full = Reading { used = 95, total = 100 }

test "below the threshold nothing is walked or killed"
  f = fakes (Reading { used = 50, total = 100 }) (crowd ()) false
  exit = run_test ((tick ()).provide_all (f.env.clone ()))
  assert_exit_success (&exit) (&Tick::Idle)
  assert! \-> killed_of (&f) == Vec::new ()

test "past the threshold the user's largest process is killed"
  f = fakes (full ()) (crowd ()) false
  exit = run_test ((tick ()).provide_all (f.env.clone ()))
  assert_exit_success (&exit) (&Tick::Killed (full ()) (proc 2 1000 300))
  assert! \-> killed_of (&f) == .to_vec ([2])

test "a refused kill is an outcome, not a failure"
  f = fakes (full ()) (crowd ()) true
  exit = run_test ((tick ()).provide_all (f.env.clone ()))
  assert_exit_success (&exit) (&Tick::KillFailed (full ()) (proc 2 1000 300) (.to_string "denied"))

test "with no owned process there is no victim"
  f = fakes (full ()) (.to_vec ([proc 1 0 9000])) false
  exit = run_test ((tick ()).provide_all (f.env.clone ()))
  assert_exit_success (&exit) (&Tick::NoVictim (full ()))
  assert! \-> killed_of (&f) == Vec::new ()

test "a zero total fails the check"
  f = fakes (Reading { used = 0, total = 0 }) (crowd ()) false
  e = expect_exit_failure (run_test ((tick ()).provide_all (f.env.clone ())))
  assert! \-> matches!(e, DaemonError::MemoryUnreadable(_))

test "a step journals what the check did"
  f = fakes (full ()) (crowd ()) false
  exit = run_test ((step ()).provide_all (f.env.clone ()))
  assert_exit_success (&exit) (&Tick::Killed (full ()) (proc 2 1000 300))
  assert! \-> lines_of (&f) == journal (&Tick::Killed (full ()) (proc 2 1000 300))

test "the schedule repeats the check on virtual time"
  f = fakes (full ()) (crowd ()) false
  schedule = (Schedule::spaced (Duration::from_secs INTERVAL_SECS)).intersect (Schedule::recurs 2)
  exit = run_test ((run_on schedule).provide_all (f.env.clone ()))
  assert! \-> matches!(exit, Exit::Success(_))
  assert! \-> killed_of (&f) == .to_vec ([2, 2, 2])

test "the daemon stops, journalled, at the first unusable reading"
  f = fakes (Reading { used = 0, total = 0 }) (crowd ()) false
  e = expect_exit_failure (run_test ((daemon ()).provide_all (f.env.clone ())))
  assert! \-> matches!(e, DaemonError::MemoryUnreadable(_))
  assert! \-> lines_of (&f) == .to_vec ([Line::Warn (.to_string "Failed to read memory: Total memory is 0, cannot calculate usage percentage")])
