-- GitHub as a capability: one method, because publishing one input's
-- proposal is all vbump asks of it.
--
-- `publish` puts the relocked flake.lock on the input's branch, as one commit
-- on top of the base revision, and opens that branch's pull request, or
-- refreshes the one already open. It is idempotent: the commit is built with
-- git plumbing (no checkout, no work tree) and dated by the base commit, so
-- the same base and the same lock give the same commit, and a second publish
-- of an unchanged proposal pushes nothing new. That is what makes it safe to
-- retry.
--
-- Three implementations: `Live` (git and gh), `DryRun` (nothing leaves the
-- machine; the plan says what would have), and `Recording` for tests.

import std::sync::{Arc, Mutex}
import id_effect::{Effect, HNil, fail, succeed, suspend}
import crate::common::{VbumpError, cmd, lifted, run}
import crate::common::VbumpError::Publish

-- One input's pull request, ready to publish.
export data Proposal
  { export input String
  , export branch String
  , export title String
  , export body String
  , export message String
  , export lock_path String
  }
  deriving (Debug, Clone, PartialEq, Eq)

export class Github
  publish : &self -> Proposal -> Effect<String, VbumpError, HNil>

export newtype Forge = Forge (export Arc<dyn Github + Send + Sync>)

instance Clone Forge
  clone : &self -> Self
  clone self = Forge (Arc::clone (&self.0))

-- The live forge: the repository at `repo`, proposals on top of `base` (a
-- commit), pushed to `remote`, pull requests against `base_branch` with
-- `label`. `gh_repo` (`owner/name`) is passed to gh when set; otherwise gh
-- reads it from the remote. `committer` (name, email) authors the commits;
-- unset, git's own configuration does. `auto_merge` (GH-247) arms GitHub's
-- auto-merge (squash) on the pull request, so it merges itself once the base
-- branch's required checks pass. `gh` is the gh program (tests: a script).
export data Live
  { export repo String
  , export base String
  , export remote String
  , export base_branch String
  , export label String
  , export gh_repo Option<String>
  , export committer Option<(String, String)>
  , export auto_merge bool
  , export gh String
  }
  deriving (Debug, Clone)

strings : Vec<&str> -> Vec<String>
strings xs = xs |> .into_iter |> .map (\s -> s.to_string ()) |> .collect

git : &Live -> Vec<&str> -> Vec<(String, String)> -> Result<String, VbumpError>
git l args env =
  mut all = .to_vec ([.to_string "-C", l.repo.clone ()]) : Vec<String>
  all.extend (strings args)
  mut c = cmd "git" all
  c.env := env
  run (&c) |> .map (\r -> r.stdout.trim () |> .to_string) |> .map_err Publish

gh : &Live -> Vec<String> -> Result<String, VbumpError>
gh l args =
  mut all = args
  if &l.gh_repo is Some r
    all.push (.to_string "--repo")
    all.push (r.clone ())
  mut c = cmd (l.gh.as_str ()) all
  c.cwd := Some (l.repo.clone ())
  run (&c) |> .map (\r -> r.stdout.trim () |> .to_string) |> .map_err Publish

dir_of : &str -> String
dir_of path = std::path::Path::new path |> .parent |> .map (\p -> p.to_string_lossy () |> .to_string) |> .unwrap_or (.to_string ".")

-- The proposal's commit: the base tree with flake.lock replaced, the base as
-- its parent, dated by the base.
commit_of : &Live -> &Proposal -> Result<String, VbumpError>
commit_of l p =
  scratch = dir_of (&p.lock_path)
  index = .to_vec ([(.to_string "GIT_INDEX_FILE", "#{scratch}/vbump.index")])
  (git l (.to_vec (["read-tree", l.base.as_str ()])) (index.clone ()))?
  blob = (git l (.to_vec (["hash-object", "-w", p.lock_path.as_str ()])) (Vec::new ()))?
  (git l (.to_vec (["update-index", "--cacheinfo", "100644,#{blob},flake.lock" |> .as_str])) (index.clone ()))?
  tree = (git l (.to_vec (["write-tree"])) (index.clone ()))?
  when = (git l (.to_vec (["show", "-s", "--format=%ct", l.base.as_str ()])) (Vec::new ()))?
  date = "@#{when} +0000"
  message_file = "#{scratch}/vbump.message"
  (std::fs::write (&message_file) (&p.message) |> .map_err (\e -> Publish ("writing #{message_file}: #{e}")))?
  mut dated = .to_vec ([(.to_string "GIT_AUTHOR_DATE", date.clone ()), (.to_string "GIT_COMMITTER_DATE", date)])
  if &l.committer is Some who
    for k in .to_vec (["GIT_AUTHOR_NAME", "GIT_COMMITTER_NAME"])
      dated.push ((k.to_string (), who.0.clone ()))
    for k in .to_vec (["GIT_AUTHOR_EMAIL", "GIT_COMMITTER_EMAIL"])
      dated.push ((k.to_string (), who.1.clone ()))
  git l (.to_vec (["commit-tree", tree.as_str (), "-p", l.base.as_str (), "-F", message_file.as_str ()])) dated

-- The proposal's commit, force-pushed to its branch.
export pushed : &Live -> &Proposal -> Result<String, VbumpError>
pushed l p =
  commit = (commit_of l p)?
  target = "#{commit}:refs/heads/#{p.branch}"
  (git l (.to_vec (["push", "--force", "--quiet", l.remote.as_str (), target.as_str ()])) (Vec::new ()))?
  Ok commit

publish_live : Live -> Proposal -> Result<String, VbumpError>
publish_live l p =
  (pushed (&l) (&p))?
  body_file = "#{dir_of (&p.lock_path)}/vbump.body.md"
  (std::fs::write (&body_file) (&p.body) |> .map_err (\e -> Publish ("writing #{body_file}: #{e}")))?
  open = (gh (&l) (strings (.to_vec (["pr", "list", "--head", p.branch.as_str (), "--state", "open", "--json", "url", "--jq", ".[0].url // \"\""]))))?
  url = if open.is_empty ()
    (gh (&l) (strings (.to_vec (["pr", "create", "--base", l.base_branch.as_str (), "--head", p.branch.as_str (), "--title", p.title.as_str (), "--body-file", body_file.as_str ()]))))?
  else
    (gh (&l) (strings (.to_vec (["pr", "edit", open.as_str (), "--title", p.title.as_str (), "--body-file", body_file.as_str ()]))))?
    open
  labelled (&l) (&url)
  if l.auto_merge
    (armed (&l) (&url))?
  Ok url

-- The gh command that arms auto-merge on `url`: squash, the only method main's
-- linear history allows.
export merge_args : &str -> Vec<String>
merge_args url = strings (.to_vec (["pr", "merge", url, "--auto", "--squash"]))

-- Auto-merge, armed once (GH-247). A pull request that has it already is left
-- as it is, so a refresh is idempotent like the push. Unlike the label, this is
-- the proposal's point: failing to arm it fails the input, and the run goes red.
armed : &Live -> &str -> Result<(), VbumpError>
armed l url =
  on = (gh l (strings (.to_vec (["pr", "view", url, "--json", "autoMergeRequest", "--jq", ".autoMergeRequest != null"]))))?
  if on == "true"
    Ok ()
  else
    gh l (merge_args url) |> .map (\_ -> ()) |> .map_err (\e -> Publish ("arming auto-merge on #{url}: #{e}"))

-- The label is a convenience for the reader, not part of the proposal: it is
-- created when missing, and a token that may not label leaves the PR as it is.
labelled : &Live -> &str -> ()
labelled l url =
  made = gh l (strings (.to_vec (["label", "create", l.label.as_str (), "--force", "--color", "0e8a16", "--description", "flake.lock bump"])))
  added = gh l (strings (.to_vec (["pr", "edit", url, "--add-label", l.label.as_str ()])))
  if made.is_err () || added.is_err ()
    eprintln! \-> "vbump: could not label #{url} #{l.label} (the token may lack issues: write)"
  ()

instance Github Live
  publish : &self -> Proposal -> Effect<String, VbumpError, HNil>
  publish self p =
    l = self.clone ()
    suspend (move \-> lifted (publish_live l p))

export live : Live -> Forge
live l = Forge (Arc::new l)

-- `--dry-run`: nothing is pushed or opened.
export data DryRun = DryRun

instance Github DryRun
  publish : &self -> Proposal -> Effect<String, VbumpError, HNil>
  publish self _p = succeed (.to_string "dry run")

export dry_run : Forge
dry_run = Forge (Arc::new DryRun)

-- For tests: every proposal published, in order; `failing` inputs always fail.
export data Recording { export published Arc<Mutex<Vec<Proposal>>>, export failing Vec<String> }
  deriving (Clone, Default)

record : &Recording -> Proposal -> String
record r p =
  url = "https://github.com/o/r/pull/#{p.input}"
  if r.published.lock () is Ok held
    mut g = held
    g.push p
  url

instance Github Recording
  publish : &self -> Proposal -> Effect<String, VbumpError, HNil>
  publish self p =
    if self.failing.contains (&p.input)
      fail (Publish ("pushing #{p.branch}: rejected"))
    else
      succeed (record self p)

export recording : Recording -> Forge
recording r = Forge (Arc::new r)

test "the scratch directory of a lock file"
  assert_eq! \-> dir_of "/tmp/vbump-1/nixpkgs/flake.lock" \-> "/tmp/vbump-1/nixpkgs"

#[cfg(test)]
sh : &str -> &str -> ()
sh dir script =
  mut c = cmd "sh" (.to_vec ([.to_string "-c", script.to_string ()]))
  c.cwd := Some (dir.to_string ())
  c.env := .to_vec ([(.to_string "GIT_AUTHOR_NAME", .to_string "t"), (.to_string "GIT_AUTHOR_EMAIL", .to_string "t@t"), (.to_string "GIT_COMMITTER_NAME", .to_string "t"), (.to_string "GIT_COMMITTER_EMAIL", .to_string "t@t")])
  run (&c) |> .expect script
  ()

test "a proposal is one commit on the base, the same commit every time, pushed to its branch"
  root = std::env::temp_dir () |> .join ("vbump-git-#{std::process::id ()}") |> .to_string_lossy |> .to_string
  std::fs::remove_dir_all (&root) |> .ok
  std::fs::create_dir_all ("#{root}/scratch") |> .expect "dirs"
  sh (&root) "git init -q --bare remote.git && git init -q repo && cd repo && echo old > flake.lock && echo x > flake.nix && git add . && git commit -qm base"
  base = run (&cmd "git" (.to_vec ([.to_string "-C", "#{root}/repo", .to_string "rev-parse", .to_string "HEAD"]))) |> .map (\r -> r.stdout) |> .expect "base" |> .trim |> .to_string
  std::fs::write ("#{root}/scratch/flake.lock") "new\n" |> .expect "lock"
  l = Live { repo = "#{root}/repo", base = base.clone (), remote = "#{root}/remote.git", base_branch = .to_string "main", label = .to_string "flake-lock", gh_repo = None, committer = Some ((.to_string "vbump", .to_string "vbump@example.invalid")), auto_merge = false, gh = .to_string "gh" }
  p = Proposal { input = .to_string "a", branch = .to_string "update/flake-lock-a", title = .to_string "t", body = .to_string "b", message = .to_string "chore(flake): bump a\n", lock_path = "#{root}/scratch/flake.lock" }
  first = pushed (&l) (&p) |> .expect "first push"
  second = pushed (&l) (&p) |> .expect "second push"
  assert_eq! \-> first \-> second
  assert_eq! \-> git_show (&root) "update/flake-lock-a:flake.lock" \-> "new\n"
  assert_eq! \-> git_show (&root) "update/flake-lock-a:flake.nix" \-> "x\n"
  parent = run (&cmd "git" (.to_vec ([.to_string "-C", "#{root}/remote.git", .to_string "rev-parse", .to_string "update/flake-lock-a^"]))) |> .map (\r -> r.stdout) |> .expect "parent" |> .trim |> .to_string
  assert_eq! \-> parent \-> base
  std::fs::remove_dir_all (&root) |> .ok

#[cfg(test)]
git_show : &str -> &str -> String
git_show root what = run (&cmd "git" (.to_vec ([.to_string "-C", "#{root}/remote.git", .to_string "show", what.to_string ()]))) |> .map (\r -> r.stdout) |> .expect "show"

-- A repository, a remote and a scripted gh that logs its arguments; `view` is
-- what `gh pr view` says about auto-merge (`true`: already armed).
#[cfg(test)]
gh_world : &str -> &str -> bool -> (String, Live, Proposal)
gh_world name view auto =
  root = std::env::temp_dir () |> .join ("vbump-gh-#{name}-#{std::process::id ()}") |> .to_string_lossy |> .to_string
  std::fs::remove_dir_all (&root) |> .ok
  std::fs::create_dir_all ("#{root}/scratch") |> .expect "dirs"
  sh (&root) "git init -q --bare remote.git && git init -q repo && cd repo && echo old > flake.lock && git add . && git commit -qm base"
  base = run (&cmd "git" (.to_vec ([.to_string "-C", "#{root}/repo", .to_string "rev-parse", .to_string "HEAD"]))) |> .map (\r -> r.stdout) |> .expect "base" |> .trim |> .to_string
  std::fs::write ("#{root}/scratch/flake.lock") "new\n" |> .expect "lock"
  script = "#!/bin/sh\necho \"$*\" >> #{root}/gh.log\ncase \"$1 $2\" in\n  'pr list') echo '' ;;\n  'pr create') echo https://github.com/o/r/pull/9 ;;\n  'pr view') echo #{view} ;;\nesac\n"
  std::fs::write ("#{root}/gh") script |> .expect "gh"
  sh (&root) "chmod +x gh"
  l = Live { repo = "#{root}/repo", base, remote = "#{root}/remote.git", base_branch = .to_string "main", label = .to_string "flake-lock", gh_repo = Some (.to_string "o/r"), committer = Some ((.to_string "vbump", .to_string "vbump@example.invalid")), auto_merge = auto, gh = "#{root}/gh" }
  p = Proposal { input = .to_string "a", branch = .to_string "update/flake-lock-a", title = .to_string "t", body = .to_string "b", message = .to_string "chore(flake): bump a\n", lock_path = "#{root}/scratch/flake.lock" }
  (root, l, p)

#[cfg(test)]
gh_calls : &str -> Vec<String>
gh_calls root = std::fs::read_to_string ("#{root}/gh.log") |> .unwrap_or_default |> .lines |> .map (\s -> s.to_string ()) |> .collect

test "auto-merge is armed, squash, on the pull request vbump opened (GH-247)"
  (root, l, p) = gh_world "arm" "false" true
  url = publish_live l p |> .expect "published"
  assert_eq! \-> url \-> "https://github.com/o/r/pull/9"
  calls = gh_calls (&root)
  assert! \-> calls.iter () |> .any (\c -> c.starts_with "pr create --base main --head update/flake-lock-a")
  assert! \-> calls.contains (&(.to_string "pr merge https://github.com/o/r/pull/9 --auto --squash --repo o/r"))
  std::fs::remove_dir_all (&root) |> .ok

test "auto-merge already armed is left alone, and off without --auto-merge"
  (root, l, p) = gh_world "armed" "true" true
  publish_live l p |> .expect "published"
  assert! \-> !(gh_calls (&root) |> .iter |> .any (\c -> c.starts_with "pr merge"))
  std::fs::remove_dir_all (&root) |> .ok
  (root2, l2, p2) = gh_world "off" "false" false
  publish_live l2 p2 |> .expect "published"
  assert! \-> !(gh_calls (&root2) |> .iter |> .any (\c -> c.starts_with "pr view" || c.starts_with "pr merge"))
  std::fs::remove_dir_all (&root2) |> .ok

test "the merge command is squash and auto"
  assert_eq! \-> merge_args "u" \-> .to_vec ([.to_string "pr", .to_string "merge", .to_string "u", .to_string "--auto", .to_string "--squash"])
