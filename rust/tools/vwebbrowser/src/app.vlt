-- The program, as one id_effect value over the window's two capabilities and
-- the services behind them.
--
--   vwebbrowser [ADDRESS]       (default: the homepage from the settings)
--
-- The root sends the view settings, opens the first tab, then runs the Tabs
-- service's supervised event consumer until the window closes or its last
-- tab does, and succeeds. However it ends, it asks the window to quit. It
-- never sees a widget: the live UiPort is gtk_edge.rs, the tests below
-- provide a fake.
--
-- The layer graph is built once, here, at the edge (`live_layer`): the
-- window (Ui, UiEvents), Settings, the Log (falling back to memory when the
-- file cannot be opened), the ProcessNode tab machines run on, and Tabs.
--
-- Exit (main.rs, through id_effect_cli's contract): 0 success, 1 typed
-- failure, 2 usage, 101 defect, 130 interrupted.

import id_effect::{Effect, Exit, HNil, Layer, Never, effect, succeed}
import id_effect_logger::LogLevel
import id_effect_process::ProcessNode
import crate::error::AppError
import crate::tabs::TabsEnv
import crate::ui::{Ui, UiCmd, UiEvents}

export const USAGE : &str = "usage: vwebbrowser [ADDRESS]"

-- What the command line asks for: an address for the first tab (None: the
-- homepage), or the usage text.
export data Start
  = Browse (Option<String>)
  | Help
  deriving (Debug, Clone, PartialEq, Eq)

-- The command line (argv, program name first). More than one argument, or a
-- flag other than --help, is a usage error.
export start_of : &[String] -> Result<Start, AppError>
start_of args =
  rest = args |> .iter |> .skip 1 |> .cloned |> .collect : Vec<String>
  if rest.is_empty ()
    Ok (Start::Browse None)
  else if rest.len () > 1
    Err (AppError::Usage ("expected at most one address, got #{rest.len ()}\n#{USAGE}"))
  else
    one = rest[0].clone ()
    if one == "--help" || one == "-h"
      Ok Start::Help
    else if one.starts_with "-"
      Err (AppError::Usage ("unknown flag #{one}\n#{USAGE}"))
    else
      Ok (Start::Browse (Some one))

-- Everything the program runs in.
export type AppEnv = TabsEnv

-- The first tab, then the window's events until it closes.
export root : Option<String> -> Effect<(), AppError, AppEnv>
root address =
  effect!
    ~crate::tabs::start(address);
    ~crate::tabs::consume()

-- Asking the window to quit cannot fail the program: a window that is gone
-- already has nothing left to quit.
quit : Effect<(), Never, AppEnv>
quit =
  effect!
    let ui = ~Ui;
    ~ui.0.send(UiCmd::Quit).catch(|_| succeed::<(), Never, HNil>(()))

-- The root, followed by Quit however it ends (success, failure, defect or
-- interrupt), so the GTK thread's Application::run returns.
export program : Option<String> -> Effect<(), AppError, AppEnv>
program address = (root address).ensuring (quit ())

-- The live layer graph: the window's two capabilities (built by the edge,
-- which shares the queue with the GTK thread), the settings from the
-- environment and XDG files, the log, the node, and an empty Tabs.
export live_layer : Ui -> UiEvents -> ProcessNode -> Layer<AppEnv, AppError>
live_layer ui events node = (crate::ui::layer ui events) |> .merge (crate::settings::live_layer ()) |> .merge (crate::log::live_or_memory_layer LogLevel::Info) |> .merge (crate::tabs::node_layer node) |> .merge (crate::tabs::layer (crate::tabs::fresh ()))

-- The exit byte of a finished program, id_effect_cli's contract
-- (exit_code_for_exit maps the same way): 0 / 1 / 101 / 130.
export exit_byte : given <A> &Exit<A, AppError> -> u8
exit_byte exit = case exit of
  Exit::Success _ -> 0
  Exit::Failure cause -> id_effect_cli::cause_max_exit_byte cause

-- Fakes: a window that records what it was asked to do. Refusing, it fails
-- every command after recording it; with a trap set, the first command equal
-- to the trap is a defect (a handler that broke).

#[cfg(test)]
import std::collections::BTreeMap
#[cfg(test)]
import std::sync::{Arc, Mutex, PoisonError}
#[cfg(test)]
import id_effect::{TestExecutor, assert_exit_success, die, expect_exit_failure, fail, run_test, run_test_on}
#[cfg(test)]
import id_effect_process::NodeName
#[cfg(test)]
import crate::error::UiError
#[cfg(test)]
import crate::log::MemoryLog
#[cfg(test)]
import crate::tabs::{Tabs, TabsError}
#[cfg(test)]
import crate::ui::{TabId, TabRow, TreeSnapshot, UiEvent, UiPort, ViewConfig, new_events, offer}

#[cfg(test)]
data FakeUi { sent Arc<Mutex<Vec<UiCmd>>>, refuse bool, trap Arc<Mutex<Option<UiCmd>>> }

#[cfg(test)]
sprung : &FakeUi -> &UiCmd -> bool
sprung ui cmd =
  mut trap = ui.trap.lock () |> .unwrap_or_else PoisonError::into_inner
  if trap.as_ref () == Some cmd
    trap.take ()
    true
  else
    false

#[cfg(test)]
instance UiPort FakeUi
  send : &self -> UiCmd -> Effect<(), UiError>
  send self cmd =
    (self.sent.lock ().unwrap_or_else PoisonError::into_inner).push (cmd.clone ())
    if self.refuse
      fail (UiError::Unavailable (.to_string "no window"))
    else if sprung self (&cmd)
      die (.to_string "the fake window broke")
    else
      succeed (())

-- One run of the program against fakes: the exit, what the window was sent,
-- the tabs left behind and the log.
#[cfg(test)]
data Run { exit Exit<(), AppError>, sent Vec<UiCmd>, tabs Tabs, log MemoryLog }

#[cfg(test)]
data Scenario { refuse bool, trap Option<UiCmd>, vars Vec<(String, String)>, argv Option<String>, events Vec<UiEvent>, shut bool }

#[cfg(test)]
scenario : Vec<UiEvent> -> Scenario
scenario events = Scenario { refuse = false, trap = None, vars = Vec::new (), argv = None, events, shut = false }

#[cfg(test)]
with_vars : Vec<(String, String)> -> Scenario -> Scenario
with_vars vars sc = Scenario { refuse = sc.refuse, trap = sc.trap, vars, argv = sc.argv, events = sc.events, shut = sc.shut }

#[cfg(test)]
with_argv : Option<String> -> Scenario -> Scenario
with_argv argv sc = Scenario { refuse = sc.refuse, trap = sc.trap, vars = sc.vars, argv, events = sc.events, shut = sc.shut }

#[cfg(test)]
with_trap : Option<UiCmd> -> Scenario -> Scenario
with_trap trap sc = Scenario { refuse = sc.refuse, trap, vars = sc.vars, argv = sc.argv, events = sc.events, shut = sc.shut }

#[cfg(test)]
with_shut : bool -> Scenario -> Scenario
with_shut shut sc = Scenario { refuse = sc.refuse, trap = sc.trap, vars = sc.vars, argv = sc.argv, events = sc.events, shut }

#[cfg(test)]
with_refuse : bool -> Scenario -> Scenario
with_refuse refuse sc = Scenario { refuse, trap = sc.trap, vars = sc.vars, argv = sc.argv, events = sc.events, shut = sc.shut }

#[cfg(test)]
ran : Scenario -> Run
ran s =
  sent = Arc::new (Mutex::new (Vec::new ()))
  ui = Ui (Arc::new (FakeUi { sent = Arc::clone (&sent), refuse = s.refuse, trap = Arc::new (Mutex::new s.trap) }))
  events = new_events ()
  for event in s.events
    assert_exit_success (&(run_test (offer (&events) event))) (&true)
  if s.shut
    shut = run_test (events.0.shutdown ()) : Exit<(), Never>
    assert_exit_success (&shut) (&())
  exec = TestExecutor::new ()
  node = ProcessNode::on_executor (NodeName::new "vwebbrowser@test") (Arc::new (exec.clone ()))
  (log, memory) = crate::log::memory LogLevel::Debug
  tabs = crate::tabs::fresh ()
  graph = (crate::ui::layer ui events) |> .merge (crate::settings::layer_from s.vars (BTreeMap::new ())) |> .merge (crate::log::layer log) |> .merge (crate::tabs::node_layer node) |> .merge (crate::tabs::layer (tabs.clone ()))
  exit = run_test_on (&exec) ((program s.argv).provide_layer graph)
  taken = (sent.lock ().unwrap_or_else PoisonError::into_inner).clone ()
  Run { exit, sent = taken, tabs, log = memory }

#[cfg(test)]
tab : u64 -> TabId
tab n = TabId { id = n }

#[cfg(test)]
s : &str -> String
s text = .to_string text

#[cfg(test)]
render_of : &UiCmd -> Option<TreeSnapshot>
render_of c = case c of
  UiCmd::RenderTree snap -> Some (snap.clone ())
  _ -> None

#[cfg(test)]
select_of : &UiCmd -> Option<TabId>
select_of c = case c of
  UiCmd::Select id -> Some (*id)
  _ -> None

#[cfg(test)]
renders : &Run -> Vec<TreeSnapshot>
renders r = r.sent |> .iter |> .filter_map render_of |> .collect

#[cfg(test)]
selects : &Run -> Vec<TabId>
selects r = r.sent |> .iter |> .filter_map select_of |> .collect

#[cfg(test)]
last_render : &Run -> TreeSnapshot
last_render r = renders r |> .pop |> .expect "a RenderTree was sent"

-- (id, depth) per row, the sidebar's shape.
#[cfg(test)]
shape : &TreeSnapshot -> Vec<(u64, usize)>
shape snap = snap.rows |> .iter |> .map (\r -> (r.id.id, r.depth)) |> .collect

#[cfg(test)]
logged : &Run -> &str -> bool
logged r needle = crate::log::lines (&r.log) |> .iter |> .any (\l -> l.contains needle)

#[cfg(test)]
argv : Vec<&str> -> Vec<String>
argv xs = xs |> .into_iter |> .map (\x -> x.to_string ()) |> .collect

#[cfg(test)]
blank_row : u64 -> usize -> &str -> bool -> TabRow
blank_row id depth uri has_children = TabRow { id = tab id, depth, title = String::new (), uri = .to_string uri, loading = false, progress = None, crashed = false, has_children }

#[cfg(test)]
homepage_vars : Vec<(String, String)>
homepage_vars = .to_vec ([(s "VWEBBROWSER_HOMEPAGE", s "https://home.example/")])

test "no argument opens the homepage; one argument is the first tab's address"
  assert_eq! \-> start_of (&(argv (.to_vec (["vwebbrowser"])))) \-> Ok (Start::Browse None)
  assert_eq! \-> start_of (&(argv (.to_vec (["vwebbrowser", "https://example.org"])))) \-> Ok (Start::Browse (Some (s "https://example.org")))

test "--help is help; two addresses or an unknown flag are usage errors"
  assert_eq! \-> start_of (&(argv (.to_vec (["vwebbrowser", "--help"])))) \-> Ok Start::Help
  assert! \-> matches!(start_of(&argv(vec!["vwebbrowser", "a", "b"])), Err(AppError::Usage(_)))
  assert! \-> matches!(start_of(&argv(vec!["vwebbrowser", "--private"])), Err(AppError::Usage(_)))

test "startup: view settings, the homepage in tab 1, the tree; a closed window exits 0 after Quit"
  sc = with_vars (homepage_vars ()) (scenario (.to_vec ([UiEvent::WindowClosed])))
  r = ran sc
  assert_exit_success (&r.exit) (&())
  assert_eq! \-> exit_byte (&r.exit) \-> 0
  tree = TreeSnapshot { rows = .to_vec ([blank_row 1 0 "https://home.example/" false]), selected = Some (tab 1) }
  config = ViewConfig { hardware_acceleration = true, developer_extras = false }
  assert_eq! \-> r.sent \-> .to_vec ([UiCmd::Configure config, UiCmd::OpenTab { id = tab 1, url = s "https://home.example/" }, UiCmd::Select (tab 1), UiCmd::RenderTree tree, UiCmd::Quit])

test "startup: the command-line address goes through the omnibox"
  sc = with_argv (Some (s "example.org")) (scenario (.to_vec ([UiEvent::WindowClosed])))
  r = ran sc
  assert_exit_success (&r.exit) (&())
  assert_eq! \-> r.sent[1] \-> UiCmd::OpenTab { id = tab 1, url = s "https://example.org" }

test "startup: a refused command-line address opens the homepage instead, with a warning"
  sc = with_argv (Some (s "javascript:alert(1)")) (with_vars (homepage_vars ()) (scenario (.to_vec ([UiEvent::WindowClosed]))))
  r = ran sc
  assert_eq! \-> r.sent[1] \-> UiCmd::OpenTab { id = tab 1, url = s "https://home.example/" }
  assert! \-> logged (&r) "not loading the command-line address"

test "ChildRequested: the new tab goes under its parent, in the background, and AdoptChild carries the nonce"
  child = UiEvent::ChildRequested { parent = tab 1, nonce = 7, uri = s "https://child.example/" }
  r = ran (scenario (.to_vec ([child, UiEvent::WindowClosed])))
  assert_exit_success (&r.exit) (&())
  assert! \-> r.sent.contains (&(UiCmd::AdoptChild { nonce = 7, id = tab 2 }))
  want = TreeSnapshot { rows = .to_vec ([blank_row 1 0 "about:blank" true, blank_row 2 1 "https://child.example/" false]), selected = Some (tab 1) }
  assert_eq! \-> last_render (&r) \-> want

test "a child of a tab that closed meanwhile still gets a (top-level) tab"
  child = UiEvent::ChildRequested { parent = tab 9, nonce = 3, uri = s "about:blank" }
  r = ran (scenario (.to_vec ([child, UiEvent::WindowClosed])))
  assert! \-> r.sent.contains (&(UiCmd::AdoptChild { nonce = 3, id = tab 2 }))
  assert_eq! \-> shape (&(last_render (&r))) \-> .to_vec ([(1, 0), (2, 0)])

test "three levels: closing the middle tab promotes its children and selects its first child"
  c2 = UiEvent::ChildRequested { parent = tab 1, nonce = 1, uri = s "about:blank" }
  c3 = UiEvent::ChildRequested { parent = tab 2, nonce = 2, uri = s "about:blank" }
  c4 = UiEvent::ChildRequested { parent = tab 2, nonce = 3, uri = s "about:blank" }
  r = ran (scenario (.to_vec ([c2, c3, c4, UiEvent::SelectRequested (tab 2), UiEvent::CloseRequested (tab 2), UiEvent::WindowClosed])))
  assert_exit_success (&r.exit) (&())
  all = renders (&r)
  before = all[all.len () - 2].clone ()
  assert_eq! \-> shape (&before) \-> .to_vec ([(1, 0), (2, 1), (3, 2), (4, 2)])
  after = last_render (&r)
  assert_eq! \-> shape (&after) \-> .to_vec ([(1, 0), (3, 1), (4, 1)])
  assert_eq! \-> after.selected \-> Some (tab 3)
  at = r.sent |> .iter |> .position (\c -> *c == UiCmd::CloseTab (tab 2)) |> .expect "CloseTab 2 was sent"
  assert_eq! \-> r.sent[at + 1] \-> UiCmd::Select (tab 3)

test "closing the last tab sends Quit and the root succeeds, with no WindowClosed"
  r = ran (scenario (.to_vec ([UiEvent::CloseRequested (tab 1), UiEvent::TitleChanged (tab 1) (s "never handled")])))
  assert_exit_success (&r.exit) (&())
  n = r.sent.len ()
  assert_eq! \-> r.sent[n - 2] \-> UiCmd::CloseTab (tab 1)
  assert_eq! \-> r.sent[n - 1] \-> UiCmd::Quit

test "Ctrl+Tab and Ctrl+Shift+Tab follow depth-first order and wrap"
  c2 = UiEvent::ChildRequested { parent = tab 1, nonce = 1, uri = s "about:blank" }
  c3 = UiEvent::ChildRequested { parent = tab 2, nonce = 2, uri = s "about:blank" }
  r = ran (scenario (.to_vec ([c2, c3, UiEvent::NewTabRequested, UiEvent::NextTabRequested, UiEvent::NextTabRequested, UiEvent::PrevTabRequested, UiEvent::PrevTabRequested, UiEvent::WindowClosed])))
  assert_exit_success (&r.exit) (&())
  assert_eq! \-> selects (&r) \-> .to_vec ([tab 1, tab 4, tab 1, tab 2, tab 1, tab 4])
  assert! \-> r.sent.contains (&UiCmd::FocusAddress)

test "the address bar: a phrase searches, a javascript: URL puts the tab's address back"
  r = ran (scenario (.to_vec ([UiEvent::AddressEntered (tab 1) (s "foo bar"), UiEvent::AddressEntered (tab 1) (s "javascript:x"), UiEvent::WindowClosed])))
  assert_exit_success (&r.exit) (&())
  assert! \-> r.sent.contains (&(UiCmd::Navigate (tab 1) (s "https://duckduckgo.com/?q=foo%20bar")))
  assert! \-> r.sent.contains (&(UiCmd::SetAddress (tab 1) (s "about:blank")))
  assert! \-> logged (&r) "not loading the address bar input"

#[cfg(test)]
flags : &TreeSnapshot -> (bool, Option<f64>, bool)
flags snap = (snap.rows[0].loading, snap.rows[0].progress, snap.rows[0].crashed)

test "load events drive the loading and progress flags; a crash shows, and Reload clears it"
  t = tab 1
  r = ran (scenario (.to_vec ([UiEvent::LoadStarted t (s "https://a.example/"), UiEvent::Progress t 40, UiEvent::LoadCommitted t, UiEvent::LoadFinished t, UiEvent::WebProcessTerminated t, UiEvent::ReloadRequested t, UiEvent::WindowClosed])))
  assert_exit_success (&r.exit) (&())
  seen = renders (&r) |> .iter |> .map flags |> .collect : Vec<(bool, Option<f64>, bool)>
  assert_eq! \-> seen \-> .to_vec ([(false, None, false), (true, Some 0.0, false), (true, Some 0.4, false), (true, Some 0.4, false), (false, None, false), (false, None, true), (true, Some 0.0, false)])
  assert! \-> r.sent.contains (&(UiCmd::SetProgress t (Some 0.4)))
  assert! \-> r.sent.contains (&(UiCmd::Reload t))

test "illegal navigation events and events for closed tabs are dropped; the consumer goes on"
  t = tab 1
  r = ran (scenario (.to_vec ([UiEvent::LoadFinished t, UiEvent::LoadCommitted t, UiEvent::CloseRequested (tab 99), UiEvent::Progress (tab 42) 10, UiEvent::TitleChanged t (s "Still here"), UiEvent::WindowClosed])))
  assert_exit_success (&r.exit) (&())
  assert_eq! \-> (last_render (&r)).rows[0].title \-> s "Still here"
  assert! \-> logged (&r) "no navigation transition"
  assert! \-> logged (&r) "which is not open"

test "a defect in a handler restarts the consumer; the tabs survive and later events are handled"
  sc = with_trap (Some (UiCmd::Select (tab 2))) (scenario (.to_vec ([UiEvent::NewTabRequested, UiEvent::SelectRequested (tab 1), UiEvent::NextTabRequested, UiEvent::WindowClosed])))
  r = ran sc
  assert_exit_success (&r.exit) (&())
  assert_eq! \-> selects (&r) \-> .to_vec ([tab 1, tab 2, tab 1, tab 2])
  assert_eq! \-> shape (&(last_render (&r))) \-> .to_vec ([(1, 0), (2, 0)])
  assert! \-> logged (&r) "restart 1"
  left = run_test (r.tabs.cell.get ()) : Exit<crate::tabs::State, Never>
  st = case left of
    Exit::Success st -> st
    Exit::Failure _ -> panic! \-> "the tabs cell is readable"
  assert_eq! \-> st.tabs.len () \-> 2
  assert_eq! \-> st.selected \-> Some (tab 2)

test "a shut-down event queue ends the root, as a closed window does"
  sc = with_shut (true) (scenario (Vec::new ()))
  r = ran sc
  assert_exit_success (&r.exit) (&())
  assert_eq! \-> r.sent.last () \-> Some (&UiCmd::Quit)

test "a window that refuses commands is a typed failure: exit 1, and Quit is still asked"
  sc = with_refuse (true) (scenario (.to_vec ([UiEvent::WindowClosed])))
  r = ran sc
  assert_eq! \-> exit_byte (&r.exit) \-> 1
  e = expect_exit_failure r.exit
  assert_eq! \-> e \-> AppError::Tabs (TabsError::Window (UiError::Unavailable (s "no window")))
  assert_eq! \-> r.sent \-> .to_vec ([UiCmd::Configure (ViewConfig { hardware_acceleration = true, developer_extras = false }), UiCmd::Quit])
