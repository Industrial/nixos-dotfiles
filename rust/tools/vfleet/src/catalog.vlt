-- The feature catalog: every feature a host can switch on. THIS FILE IS THE
-- SOURCE OF TRUTH (GH-417 S2); features/catalog.json is generated from it
-- (`bin/fleet-data`) and features/catalog.nix turns that JSON into paths.
--
-- lib/mk-host.nix wraps each entry with lib/features.nix and imports the lot into
-- every host, which declares `features.<category>.<name>.enable` (default false)
-- for each. Profiles and hosts then turn features on by option instead of by
-- import, and turn them off with `lib.mkForce false` instead of commenting lines
-- out.
--
-- Option name = path below features/, minus `.nix` / `/default.nix`:
--   f Category::Fleet "comin.nix"         -> features.fleet.comin.enable
--   f Category::Nixos "graphics/amd.nix"  -> features.nixos.graphics.amd.enable
--
-- Features that another feature imports (claude-code's ../lean-ctx,
-- remote-access's ../network/ssh) are reached through that import and need no
-- entry here; enabling the parent enables them with mkDefault.
--
-- Adding a feature: add it here, run `bin/fleet-data`, then enable it from a
-- profile or host. Features left out (openhands, mullvad, the mimir media stack,
-- ...) are not evaluated on any host. Order is kept: it is the module import
-- order.

import crate::model::{Category, Feature}

f : Category -> &str -> Feature
f category rest = Feature { category, rest = rest.to_string () }

export catalog : Vec<Feature>
catalog =
