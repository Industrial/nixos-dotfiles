export DIRENV_WARN_TIMEOUT=20s

eval "$(devenv direnvrc)"

if [ -f .gitmodules ] && command -v git >/dev/null 2>&1; then
    git submodule update --init --recursive .cursor 2>/dev/null || true
    bash scripts/patch-cursor-mcp.sh 2>/dev/null || true
fi

# Prefer repo wrappers (e.g. scripts/hermes clears devenv PYTHONPATH for py3.14 Hermes).
PATH_add scripts

use devenv
