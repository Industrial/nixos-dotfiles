# Colocated suite: 00-nixos-env.nu rendering.
#
# This is a pure string transform, so it is the one part of the keystone that can be pinned
# exactly. Three things actually break here and all three are asserted below: a `$HOME` left
# literal (Nushell does not expand it, so XDG_CACHE_HOME becomes a directory called `$HOME`), a
# profile-relative name restated from its bare value (which silently truncates XDG_DATA_DIRS to
# two of its eight entries), and an unescaped quote in a value (which makes the file unparsable
# and takes the whole prompt down with it).
let
  assay = import ./../../../common/assay/default.nix;
  lib = (import <nixpkgs> {}).lib;

  render = args:
    import ./nu-env.nix ({
        inherit lib;
      }
      // args);

  text = render {
    sessionVariables = {
      EDITOR = "nvim";
      DIFFPROG = "nvim -d";
      XDG_CACHE_HOME = "$HOME/.cache";
      BRACED = "${"$"}{XDG_STATE_HOME}/nix";
      JOINED = ["/one" "/two"];
      QUOTED = ''say "hi"'';
      BACKSLASH = "a\\b";
      EMPTY = "";
      DROPPED = null;
      XDG_DATA_DIRS = "/only/two/entries";
    };
    reservedNames = ["PATH" "XDG_DATA_DIRS"];
  };

  has = needle: builtins.match ".*${lib.escapeRegex needle}.*" text != null;
in
  assay.suite "shell-init-nu-env" {
    # A literal value needs no expression machinery at all.
    plainValue = assay.eq (has ''if "EDITOR" not-in $env { $env.EDITOR = ("nvim") }'') true;

    # Spaces survive: this is the value that a shell loop in an activation script would split.
    valueWithSpace = assay.eq (has ''$env.DIFFPROG = ("nvim -d")'') true;

    # The defect this generator exists for: `$HOME` is shell syntax, and Nushell expands none
    # of it. Writing it through verbatim gives a path starting with a dollar sign.
    dollarHomeBecomesEnvLookup =
      assay.eq (has ''$env.XDG_CACHE_HOME = (($env.HOME? | default "") + "/.cache")'') true;
    noLiteralDollarHome = assay.eq (has ''"$HOME'') false;

    # `${"$"}{NAME}` is the other shell spelling of the same thing.
    bracedReferenceExpands =
      assay.eq (has ''$env.BRACED = (($env.XDG_STATE_HOME? | default "") + "/nix")'') true;

    # environment.variables accepts a list; /etc/set-environment joins it with ":".
    listValueJoinsWithColon = assay.eq (has ''$env.JOINED = ("/one:/two")'') true;

    # An unescaped quote would end the Nu string and make the file unparsable.
    quoteIsEscaped = assay.eq (has ''$env.QUOTED = ("say \"hi\"")'') true;
    backslashIsEscaped = assay.eq (has ''$env.BACKSLASH = ("a\\b")'') true;

    # An empty value is still a value: `""`, not a bare `()`.
    emptyValueIsEmptyString = assay.eq (has ''$env.EMPTY = ("")'') true;

    # A null in sessionVariables means "not set", not "set to null".
    nullIsOmitted = assay.eq (has "DROPPED") false;

    # Reserved names are left to the session. NixOS appends profile-relative entries to these
    # when it writes /etc/set-environment, and the bare option value no longer has them.
    reservedNameIsSkipped = assay.eq (has "XDG_DATA_DIRS") false;

    # Non-destructive by construction: a pam session or a `nix develop` already holds the right
    # value, and clobbering it is a regression rather than a fix. Eight of the ten inputs
    # survive the filter, and every one of them must be guarded.
    guardsEveryAssignment =
      assay.eq
      (builtins.length (builtins.filter (line: lib.hasInfix "not-in $env {" line) (lib.splitString "\n" text)))
      8;

    # The file says where it came from; somebody will find it in ~ and wonder.
    carriesProvenanceHeader = assay.eq (has "Generated by features/cli/shell-init") true;
  }
