# `00-nixos-env.nu` — NixOS session variables rendered as Nushell assignments.
#
# Split out of default.nix so the rendering can be unit-tested as a pure string transform
# (nu-env.assay.nix), which is the only way to pin the escaping without a live shell. It is a
# Nix-side generator rather than a loop in the activation script because the values carry
# spaces, `$` and `"` — quoting those twice through sh is how this kind of glue breaks.
{
  lib,
  # config.environment.sessionVariables
  sessionVariables,
  # Names NixOS augments with profile-relative entries when it writes /etc/set-environment and
  # /etc/pam/environment. Restating the bare value would drop those suffixes.
  reservedNames ? [],
}:
with lib; let
  # `environment.variables` accepts a list, which /etc/set-environment joins with ":".
  flatten = value:
    if isList value
    then concatStringsSep ":" (map toString value)
    else toString value;

  # A `$NAME` or `${NAME}` in a sessionVariables value is shell syntax, not literal text:
  # XDG_CACHE_HOME is declared as "$HOME/.cache". Nushell expands neither, so the value is
  # split on those references and rebuilt as a Nu expression.
  # Bracketed rather than backslash-escaped: `builtins.split` is POSIX ERE, where `\{` is not
  # a valid escape and the whole pattern is rejected at eval time.
  varRef = "[$][{]([a-zA-Z_][a-zA-Z0-9_]*)[}]|[$]([a-zA-Z_][a-zA-Z0-9_]*)";

  # Plain Nu double quotes do not interpolate, so only the backslash, the quote and the
  # newline need escaping — `$` and `(` stay literal, unlike in a `$"..."` string.
  nuLiteral = s: ''"${replaceStrings ["\\" "\"" "\n"] ["\\\\" "\\\"" "\\n"] s}"'';

  nuExpr = raw: let
    piece = part:
      if isString part
      then
        if part == ""
        then null
        else nuLiteral part
      # `?` plus `default` because a referenced variable may genuinely be unset, and an
      # autoload file that throws takes the whole prompt with it.
      else ''($env.${head (filter (group: group != null) part)}? | default "")'';
    pieces = filter (p: p != null) (map piece (builtins.split varRef raw));
  in
    if pieces == []
    then ''""''
    else concatStringsSep " + " pieces;

  # `$env.FOO` needs a bare identifier; anything else goes through a quoted cell-path member.
  nuMember = name:
    if builtins.match "[a-zA-Z_][a-zA-Z0-9_]*" name != null
    then name
    else nuLiteral name;

  # Assign only what the session is missing. On a pam-authenticated login every one of these is
  # already present and already expanded, so this file is the fallback for sessions that bypass
  # pam_env — and staying non-destructive means a `nix develop` or direnv environment entered
  # before `nu` keeps its own NIX_PATH and LOCALE_ARCHIVE. env.nu uses the same not-in-$env
  # guard for DOCKER_HOST.
  assign = name: value: ''if "${name}" not-in $env { $env.${nuMember name} = (${nuExpr (flatten value)}) }'';

  wanted =
    filterAttrs
    (name: value: !(elem name reservedNames) && value != null)
    sessionVariables;
in ''
  # Generated by features/cli/shell-init from config.environment.sessionVariables.
  # Do not edit: `nixos-rebuild switch` replaces this file.
  ${concatStringsSep "\n" (mapAttrsToList assign wanted)}
''
