% dotfiles, help, tldr, navi

; Read out of features/cli/tealdeer, features/cli/navi and features/cli/cheatsheet — the three
; features that make up this fleet's help stack.

# The tldr page for a command, out of the offline cache; this never opens a socket
tldr <command>

# Every command the local page cache has a page for
tldr --list

# Which config file and page directory tealdeer is actually using
tldr --show-paths

# Refresh the page cache now rather than waiting for the weekly timer
systemctl --user start tealdeer-pages-refresh.service

# When the page cache refreshes next, and when it last ran
systemctl --user list-timers tealdeer-pages-refresh.timer

# Why the last refresh failed; a failed refresh deliberately does not fail the unit
journalctl --user -u tealdeer-pages-refresh.service -n 50

# Browse every cheatsheet navi can see
navi

# Only this repo's own entries
navi --tag-rules dotfiles

# Everything about this repo except one topic
navi --tag-rules 'dotfiles,!stig'

# Pick an entry and print it instead of running it
navi --print

# Autoselect the entry that best matches a query, with no finder at all
navi --query '<query>' --best-match --print

# Render a tldr page through navi, out of the local tealdeer cache
navi --tldr <command>

# Where navi looks for .cheat files by default
navi info cheats-path

# A worked example of the .cheat format, for adding an entry
navi info cheats-example

# The one command in this stack that needs the network: cheat.sh's generic answer
cheatsheet --web <command>

$ command: tldr --list
