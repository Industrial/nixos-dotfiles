# Btop is a htop replacement
#
# btop's built-in default theme is a truecolor green/blue that owes nothing to the fleet's
# scheme, and it is the most colourful pane in the `system` zellij layout. btop has no theme
# environment variable and no include mechanism: a theme is a file, and the only way to
# select one is `color_theme` in btop.conf. So both are generated here.
#
# btop.conf is INSTALLED AS A WRITABLE COPY, not symlinked into the store the way this repo
# links alacritty.toml, ghostty's config and yazi.toml. btop rewrites its whole config file
# when it exits, and none of those other tools do; pointing it at a read-only store path
# would make every quit an error. Copying keeps the file declarative -- each activation
# restores exactly what is generated here -- while leaving btop free to write to it in
# between. Runtime preference changes still do not survive a rebuild, so settings that should
# persist belong in this file.
{
  settings,
  pkgs,
  ...
}: let
  palette = import ./../../window-manager/stylix/palette.nix;
  c = palette.withHash;

  # tinted-theming/tinted-btop's mapping. Every key below appears in btop 1.4.8's own bundled
  # themes, which is what the colocated suite checks it against -- btop silently ignores a
  # key it does not know, so a typo here would be invisible at runtime.
  #
  # The `_start`/`_mid`/`_end` triples are gradients btop interpolates across a meter or
  # graph, so each one is given three *different* hues and ordered low-to-high: temperature
  # and usage run green -> yellow -> red, which is the conventional reading and happens to be
  # base0B -> base0A -> base08.
  themeFile = pkgs.writeTextFile {
    name = "btop-stylix.theme";
    text = ''
      # Generated from features/window-manager/stylix/palette.nix; do not hand-edit.
      theme[main_bg]="${c.base00}"
      theme[main_fg]="${c.base05}"
      theme[title]="${c.base05}"
      theme[hi_fg]="${c.base0D}"
      theme[selected_bg]="${c.base02}"
      theme[selected_fg]="${c.base0D}"
      theme[inactive_fg]="${c.base03}"
      theme[graph_text]="${c.base04}"
      theme[meter_bg]="${c.base02}"
      theme[proc_misc]="${c.base0C}"
      theme[cpu_box]="${c.base0D}"
      theme[mem_box]="${c.base0B}"
      theme[net_box]="${c.base08}"
      theme[proc_box]="${c.base0E}"
      theme[div_line]="${c.base02}"
      theme[temp_start]="${c.base0B}"
      theme[temp_mid]="${c.base0A}"
      theme[temp_end]="${c.base08}"
      theme[cpu_start]="${c.base0C}"
      theme[cpu_mid]="${c.base0D}"
      theme[cpu_end]="${c.base0E}"
      theme[free_start]="${c.base0E}"
      theme[free_mid]="${c.base0D}"
      theme[free_end]="${c.base0C}"
      theme[cached_start]="${c.base0C}"
      theme[cached_mid]="${c.base0D}"
      theme[cached_end]="${c.base0E}"
      theme[available_start]="${c.base09}"
      theme[available_mid]="${c.base0A}"
      theme[available_end]="${c.base08}"
      theme[used_start]="${c.base0B}"
      theme[used_mid]="${c.base0A}"
      theme[used_end]="${c.base08}"
      theme[download_start]="${c.base0B}"
      theme[download_mid]="${c.base0A}"
      theme[download_end]="${c.base08}"
      theme[upload_start]="${c.base0B}"
      theme[upload_mid]="${c.base0A}"
      theme[upload_end]="${c.base08}"
      theme[process_start]="${c.base0B}"
      theme[process_mid]="${c.base0A}"
      theme[process_end]="${c.base08}"
    '';
  };

  # `color_theme` takes an absolute path as readily as a bare theme name, so naming the /etc
  # path directly means the theme needs no second copy under the user's config dir. The theme
  # is the half btop only ever reads, so unlike btop.conf it stays in /etc.
  #
  # `theme_background = False` makes btop leave the pane background to the terminal emulator,
  # which features/window-manager/{alacritty,ghostty} now paint base00 -- the same value
  # theme[main_bg] carries. Painting it here as well would put a subtly different rectangle
  # over a transparent window (alacritty.toml sets opacity 0.85).
  btopConf = pkgs.writeTextFile {
    name = "btop.conf";
    text = ''
      # Generated by features/cli/btop; btop cannot persist changes over this file.
      color_theme = "/etc/btop/themes/stylix.theme"
      theme_background = False
      truecolor = True
    '';
  };
in {
  environment = {
    systemPackages = with pkgs; [
      btop
    ];
    etc = {
      "btop/themes/stylix.theme" = {
        source = themeFile;
      };
      "btop/btop.conf" = {
        source = btopConf;
      };
    };
  };

  # Activation script names share one namespace across every feature, so this one is named
  # for its feature rather than the generic `linkFile`, which
  # features/window-manager/alacritty already defines.
  system.activationScripts.linkBtopConfig = {
    text = ''
      mkdir -p ${settings.userdir}/.config/btop
      install -m 0644 /etc/btop/btop.conf ${settings.userdir}/.config/btop/btop.conf
      chown ${settings.username} ${settings.userdir}/.config/btop/btop.conf
    '';
  };
}
