<?xml version="1.0"?>
<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">

  <Script file="RSEntityPinMixin.lua"/>
  
  <Button name="RSEntityPinTemplate" mixin="RSEntityPinMixin" virtual="true">
		<Size>
			<AbsDimension x="18" y="18"/>
		</Size>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Texture">
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
		    	<Texture parentKey="IconTexture" useAtlasSize="true">
		        	<Anchors>
            			<Anchor point="TOPLEFT" relativeKey="$parent.Texture" relativePoint="CENTER" x="-2" y="-2"/>
            			<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Texture" relativePoint="BOTTOMRIGHT" x="0" y="-2"/>
					</Anchors>
		        </Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="7">
				<Texture parentKey="HighlightRing" file="Interface\Minimap\UI-Minimap-Ping-Expand" alphaMode="ADD" alpha="0" hidden="true">
					<Size x="28" y="28"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Texture" relativePoint="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Animations>
			<AnimationGroup parentKey="HighlightRingAnim" setToFinalAlpha="false" looping="REPEAT">
				<Scale childKey="HighlightRing" duration="1.0" order="1" fromScaleX="0.8" fromScaleY="0.8" toScaleX="1.8" toScaleY="1.8"/>
				<Alpha childKey="HighlightRing" duration="0.3" order="1" fromAlpha="0" toAlpha="0.8"/>
				<Alpha childKey="HighlightRing" startDelay="0.3" duration="0.7" order="1" fromAlpha="0.8" toAlpha="0"/>
			</AnimationGroup>
	        <AnimationGroup parentKey="ShowPingAnim" setToFinalAlpha="false" looping="BOUNCE">
	          <Alpha duration="0.1" order="1" fromAlpha="0" toAlpha="1"/>
	          <Alpha startDelay="0.1" duration="0.5" order="1" fromAlpha="1" toAlpha="0"/>
	          <Scale duration="0.25" order="1" fromScaleX="0.75" fromScaleY="0.75" toScaleX="1.75" toScaleY="1.75"/>
	          <Alpha duration="0.5" order="1" fromAlpha="0" toAlpha="1"/>
	          <Alpha startDelay="0.5" duration="0.5" order="1" fromAlpha="1" toAlpha="0"/>
	          <Scale duration="0.75" order="1" fromScaleX="1" fromScaleY="1" toScaleX="1.5" toScaleY="1.5"/>
	        </AnimationGroup>
	        <AnimationGroup parentKey="ShowSearchAnim">
	          <Alpha duration="0.1" order="1" fromAlpha="0" toAlpha="1"/>
	          <Alpha startDelay="0.1" duration="0.5" order="1" fromAlpha="1" toAlpha="0"/>
	          <Scale duration="0.25" order="1" fromScaleX="0.75" fromScaleY="0.75" toScaleX="1.75" toScaleY="1.75"/>
	          <Alpha duration="0.5" order="1" fromAlpha="0" toAlpha="1"/>
	          <Alpha startDelay="0.5" duration="0.5" order="1" fromAlpha="1" toAlpha="0"/>
	          <Scale duration="0.75" order="1" fromScaleX="1" fromScaleY="1" toScaleX="1.5" toScaleY="1.5"/>
	        </AnimationGroup>
		</Animations>
		<Scripts>
			<OnMouseDown method="OnMouseDown"/>
		    <OnEnter method="OnMouseEnter"/>
		    <OnLeave method="OnMouseLeave"/>
		</Scripts>
	</Button>
  
</Ui>