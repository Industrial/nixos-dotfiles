<Bindings>
	<!-- auxForever 0.8.3: the Standing Buy key. A key press is a hardware event, which is the only
	     way the auction house takes a purchase from an addon, so this is how a snipe is bought with
	     the hand on the keyboard. It presses the panel's own button; what the press then does is in
	     tabs/sniper/standing_buy.lua, which also decides whether there is anything to buy. That
	     button lives on UIParent and is always there, so the binding is never "not set up yet". -->
	<Binding name="AUXFOREVER_STANDING_BUY" header="AUXFOREVER">
		auxForeverStandingBuy:Click('LeftButton')
	</Binding>
	<!-- auxForever 0.8.4: the same key for the Search tab's Rapid Buy panel, which keeps the cheapest
	     result of a search armed and reads the rest of the queue ahead of the press. Its button also
	     lives on UIParent; tabs/search/rapid_buy.lua decides whether there is anything to buy. -->
	<Binding name="AUXFOREVER_RAPID_BUY" header="AUXFOREVER">
		auxForeverRapidBuy:Click('LeftButton')
	</Binding>
</Bindings>
