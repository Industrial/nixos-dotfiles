{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Fleet health",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "1 = host reachable and scraping, 0 = DOWN",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "index": 1, "text": "DOWN"},
                "1": {"color": "green", "index": 0, "text": "UP"}
              },
              "type": "value"
            }
          ],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "up{job=\"nodes\"}",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Hosts up",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "1-minute load average per host",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 12, "lineWidth": 2, "showPoints": "never"},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 9, "x": 6, "y": 1},
      "id": 2,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "node_load1{job=\"nodes\"}",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Load average (1m)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "(MemTotal - MemAvailable) / MemTotal",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 12, "lineWidth": 2, "showPoints": "never"},
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 9, "x": 15, "y": 1},
      "id": 3,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"nodes\"} / node_memory_MemTotal_bytes{job=\"nodes\"})",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Memory used",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "id": 101,
      "panels": [],
      "title": "CPU & disk",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Non-idle CPU time across all cores",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 12, "lineWidth": 2, "showPoints": "never"},
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 80},
              {"color": "red", "value": 95}
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "id": 4,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{job=\"nodes\", mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "CPU busy",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Used bytes / size of the root filesystem",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 12, "lineWidth": 2, "showPoints": "never"},
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 75},
              {"color": "red", "value": 90}
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "id": 5,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"nodes\", fstype!~\"tmpfs|overlay|squashfs|nfs.*\", mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"nodes\", fstype!~\"tmpfs|overlay|squashfs|nfs.*\", mountpoint=\"/\"})",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Root filesystem used",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "id": 102,
      "panels": [],
      "title": "Network",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Received bits/s on non-virtual interfaces",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 12, "lineWidth": 2, "showPoints": "never"},
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
      "id": 6,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "irate(node_network_receive_bytes_total{job=\"nodes\", device!~\"lo|veth.*|docker.*|br-*|tun[0-9]*\"}[$__rate_interval]) * 8",
          "legendFormat": "{{host}} {{device}}",
          "refId": "A"
        }
      ],
      "title": "Network in",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Transmitted bits/s on non-virtual interfaces",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 12, "lineWidth": 2, "showPoints": "never"},
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
      "id": 7,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "irate(node_network_transmit_bytes_total{job=\"nodes\", device!~\"lo|veth.*|docker.*|br-*|tun[0-9]*\"}[$__rate_interval]) * 8",
          "legendFormat": "{{host}} {{device}}",
          "refId": "A"
        }
      ],
      "title": "Network out",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["fleet"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Fleet Overview",
  "uid": "fleet-overview",
  "version": 1,
  "weekStart": ""
}
