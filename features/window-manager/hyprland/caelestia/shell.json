{
  "general": {
    "apps": {
      "terminal": [
        "alacritty"
      ],
      "audio": [
        "pavucontrol"
      ],
      "explorer": [
        "nautilus"
      ]
    },
    "idle": {
      "lockBeforeSleep": true,
      "inhibitWhenAudio": true,
      "inhibitWhenCharging": false,
      "timeouts": [
        {
          "timeout": 300,
          "idleAction": "lock"
        },
        {
          "timeout": 600,
          "idleAction": "dpms off",
          "returnAction": "dpms on"
        },
        {
          "timeout": 900,
          "idleAction": [
            "systemctl",
            "suspend"
          ]
        }
      ]
    }
  },
  "bar": {
    "persistent": true,
    "workspaces": {
      "shown": 10,
      "perMonitorWorkspaces": true
    },
    "tray": {
      "compact": true
    }
  },
  "launcher": {
    "maxWallpapers": 99,
    "useFuzzy": {
      "wallpapers": true
    }
  },
  "osd": {
    "enabled": true,
    "enableBrightness": true,
    "enableMicrophone": true
  },
  "session": {
    "enabled": true
  },
  "lock": {
    "enabled": true
  },
  "paths": {
    "wallpaperDir": "/data/Images/Wallpapers"
  }
}
