{
    "bar": {
        "persistent": true,
        "statusIcons": [
            {
                "enabled": true,
                "id": "lockStatus"
            },
            {
                "enabled": true,
                "id": "audio"
            },
            {
                "enabled": true,
                "id": "microphone"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "battery"
            }
        ],
        "tray": {
            "compact": true
        },
        "workspaces": {
            "perMonitorWorkspaces": true,
            "shown": 10
        }
    },
    "general": {
        "apps": {
            "audio": [
                "pavucontrol"
            ],
            "explorer": [
                "nautilus"
            ],
            "terminal": [
                "alacritty"
            ]
        },
        "idle": {
            "inhibitWhenAudio": true,
            "inhibitWhenCharging": false,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "idleAction": "lock",
                    "timeout": 300
                },
                {
                    "idleAction": "dpms off",
                    "returnAction": "dpms on",
                    "timeout": 600
                },
                {
                    "idleAction": [
                        "systemctl",
                        "suspend"
                    ],
                    "timeout": 900
                }
            ]
        }
    },
    "launcher": {
        "hiddenApps": [
            "org.gnome.Settings"
        ],
        "maxWallpapers": 99,
        "useFuzzy": {
            "wallpapers": true
        }
    },
    "lock": {
        "enabled": true
    },
    "osd": {
        "enableBrightness": true,
        "enableMicrophone": true,
        "enabled": true
    },
    "paths": {
        "wallpaperDir": "/data/Images/Wallpapers"
    },
    "session": {
        "enabled": true
    },
    "utilities": {
        "quickToggles": [
            {
                "enabled": true,
                "id": "wifi"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "mic"
            },
            {
                "enabled": true,
                "id": "gameMode"
            },
            {
                "enabled": true,
                "id": "dnd"
            }
        ]
    }
}
