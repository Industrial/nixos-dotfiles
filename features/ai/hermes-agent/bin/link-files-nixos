#!/usr/bin/env bash
set -e

echo "features > ai > hermes-agent > link-files-nixos"

currentDirectoryPath=$(pwd)
sourceDirectoryPath="${currentDirectoryPath}/features/ai/hermes-agent/.hermes"
targetDirectoryPath="${HOME}/.hermes"

rm -rf "${targetDirectoryPath}"
ln -sf "${sourceDirectoryPath}" "${targetDirectoryPath}"
