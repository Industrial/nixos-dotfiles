{
  "mcpServers": {
    "chromedevtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "directTools": true
    },
    "mcp-debugger": {
      "command": "npx",
      "args": [
        "-y",
        "@debugmcp/mcp-debugger",
        "stdio",
        "--log-level",
        "debug",
        "--log-file",
        "./tmp/debug-mcp-server.log"
      ],
      "autoApprove": ["create_debug_session", "set_breakpoint", "get_variables"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@latest"]
    },
    "temporal": {
      "command": "uvx",
      "args": [
        "temporal-mcp-server",
        "--host",
        "127.0.0.1:7233",
        "--namespace",
        "default",
        "--tls-enabled",
        "false"
      ],
      "description": "Temporal workflows/schedules via MCP (temporal-mcp-server; see https://github.com/GethosTheWalrus/temporal-mcp)"
    },
    "lean-ctx": {
      "command": "lean-ctx",
      "args": [],
      "description": "lean-ctx MCP (context compression; https://github.com/yvgude/lean-ctx)"
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": ["start-mcp-server"],
      "description": "Serena MCP (@oraios/serena); stdio via uv + devenv"
    },
    "roam-code": {
      "type": "stdio",
      "command": "roam",
      "args": ["mcp"],
      "description": "roam-code MCP via devenv (`roam mcp` + fastmcp)"
    },
    "beads": {
      "type": "stdio",
      "command": "/home/tom/.dotfiles/features/ai/pi/bin/pi-mcp-beads",
      "args": [],
      "lifecycle": "lazy",
      "description": "Beads (bd) issue tracking — 110 tools via pi-mcp-beads",
      "directTools": [
        "bd_ready",
        "bd_show",
        "bd_create",
        "bd_close",
        "bd_update",
        "bd_list",
        "bd_sync",
        "bd_prime",
        "bd_blocked",
        "bd_dep_add"
      ]
    }
  },
  "imports": []
}
