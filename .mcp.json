{
  "mcpServers": {
    "mcp-debugger": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@debugmcp/mcp-debugger",
        "stdio",
        "--log-level",
        "debug",
        "--log-file",
        ".tmp/debug-mcp-server.log"
      ],
      "autoApprove": ["create_debug_session", "set_breakpoint", "get_variables"]
    },
    "lean-ctx": {
      "type": "stdio",
      "command": "lean-ctx",
      "args": [],
      "description": "lean-ctx MCP from the system profile (features/ai/lean-ctx), not devenv, so it starts under paseo and any other non-login launcher"
    },
    "roam-code": {
      "type": "stdio",
      "command": "roam",
      "args": ["mcp"],
      "description": "roam-code MCP from the system profile (features/ai/roam-code), not devenv, so it starts under paseo and any other non-login launcher"
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": {
        "UV_PYTHON_PREFERENCE": "only-system",
        "UV_PYTHON_DOWNLOADS": "never"
      }
    },
    "git": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-git"],
      "env": {
        "UV_PYTHON_PREFERENCE": "only-system",
        "UV_PYTHON_DOWNLOADS": "never"
      }
    },
    "time": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-time"],
      "env": {
        "UV_PYTHON_PREFERENCE": "only-system",
        "UV_PYTHON_DOWNLOADS": "never"
      }
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@latest"]
    }
  }
}
