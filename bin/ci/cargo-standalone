#!/usr/bin/env bash
# Lint, test and drift-check the standalone crates under rust/tools/, and drift-check the
# workspace members' Cargo.nix files.
#
#   bin/ci/cargo-standalone --list           JSON array of the standalone crates' names
#   bin/ci/cargo-standalone clippy <crate>   cargo clippy --all-targets -- -D warnings
#   bin/ci/cargo-standalone test <crate>     cargo test
#   bin/ci/cargo-standalone drift <crate>    Cargo.nix against a fresh crate2nix (if it has one)
#   bin/ci/cargo-standalone package <crate>  nix build its default.nix as the fleet does
#   bin/ci/cargo-standalone all [<crate>…]   all four, for every crate or the ones named
#   bin/ci/cargo-standalone --members        JSON array of rust/Cargo.toml's members under rust/tools
#   bin/ci/cargo-standalone workspace-drift  `drift` for every workspace member with a Cargo.nix
#
# A standalone crate has its own Cargo.lock and an empty [workspace] table, so the
# workspace jobs (`cd rust && cargo … --workspace`) never see it. The list is found, not
# written down: the `standalone-crates` job in .github/workflows/ci.yml feeds --list to the
# `cargo-standalone` matrix, so a new crate is gated without an edit there.
#
# --list fails when it finds no crate, and when a rust/tools/*/Cargo.toml is neither a
# member of rust/Cargo.toml nor standalone: that crate would be checked by no job.
#
# workspace-drift is ci.yml's `cargo-nix-drift` job. A workspace member can still carry a
# Cargo.nix of its own (oomkiller does: its `oomkiller-src` flake input builds the crate
# directory alone, with its own Cargo.lock), and the workspace jobs never look at it. The
# job used to run `cargo generate-lockfile` in rust/ and diff the Cargo.nix files, which
# regenerates no Cargo.nix and so passed on any drift (#165); it now runs the same
# copy-regenerate-diff as `drift`. --members, and so workspace-drift, fails when rust/tools
# has no workspace member left: the job checks nothing then, and should go.
#
# `package` exists because cargo passing says nothing about the Nix package: vgc built and
# linked under cargo, then failed in drakkar's build with `ld: cannot find -lsqlite3`
# (nixpkgs' cargoUseSystemLibs hook turns libsqlite3-sys's `bundled` off; #170). It
# callPackages default.nix exactly as the features do (`pkgs.callPackage
# ../../../rust/tools/<crate> {}`), with a host's own pkgs: the flake's nixpkgs plus the
# config and overlays features/nixos gives every host. CARGO_STANDALONE_HOST picks the
# host (default drakkar, the one that deploys); the source is the flake's copy, so only
# tracked files count, as in the fleet. The derivation's checkPhase runs the tests again,
# in the sandbox.
#
# A crate that links system libraries names them in rust/tools/<crate>/ci-inputs, one
# nixpkgs attribute per line (blank lines and # comments allowed): clippy and test then run
# in a mkShell with those as buildInputs, so pkg-config finds them (see DEV_SHELL_EXPR).
# Crates without the file run under plain `nix shell` as before.
#
# RUST_DIR (default rust/) points --list, clippy and test at another tree;
# bin/dev.d/test.sh uses it.
#
# The `bash -c '…"$1"…' _ "$dir"` calls are single-quoted on purpose: the inner shell
# expands $1, so a path never becomes part of a command string.
# shellcheck disable=SC2016
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"
# shellcheck source=bin/lib/flake-ref.sh
source "$ROOT/bin/lib/flake-ref.sh"

die() {
  echo "cargo-standalone: $*" >&2
  exit 1
}

# list [standalone|members]: the crates of that kind under rust/tools, as a JSON array.
list() {
  python3 -I - "${RUST_DIR:-$ROOT/rust}" "${1:-standalone}" <<'PY'
import glob, json, os, sys, tomllib

rust, kind = sys.argv[1], sys.argv[2]
with open(os.path.join(rust, "Cargo.toml"), "rb") as f:
    ws = tomllib.load(f).get("workspace", {})

def expand(patterns):
    out = set()
    for p in patterns:
        out.update(os.path.normpath(d) for d in glob.glob(os.path.join(rust, p)))
    return out

members = expand(ws.get("members", [])) - expand(ws.get("exclude", []))
found, in_ws, orphans = [], [], []
for manifest in sorted(glob.glob(os.path.join(rust, "tools", "*", "Cargo.toml"))):
    crate = os.path.dirname(manifest)
    with open(manifest, "rb") as f:
        standalone = "workspace" in tomllib.load(f)
    if os.path.normpath(crate) in members:
        if standalone:
            orphans.append(f"{crate}: has its own [workspace] but is a member of {rust}/Cargo.toml")
        else:
            in_ws.append(os.path.basename(crate))
    elif standalone:
        found.append(os.path.basename(crate))
    else:
        orphans.append(f"{crate}: neither a member of {rust}/Cargo.toml nor standalone ([workspace] table)")

for o in orphans:
    print(f"cargo-standalone: {o}", file=sys.stderr)
if orphans:
    sys.exit(1)
if kind == "members":
    if not in_ws:
        print(f"cargo-standalone: no workspace member under {rust}/tools: "
              "the cargo-nix-drift job checks nothing, remove it", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(in_ws))
    sys.exit(0)
if not found:
    print(f"cargo-standalone: no standalone crate under {rust}/tools", file=sys.stderr)
    sys.exit(1)
print(json.dumps(found))
PY
}

# The crate's directory, after checking the name is one --list found.
crate_dir() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "not a crate name: '$name'"
  list | jq -e --arg c "$name" 'index($c) != null' >/dev/null \
    || die "'$name' is not a standalone crate under rust/tools"
  echo "${RUST_DIR:-rust}/tools/$name"
}

# ci_inputs <crate dir>: the nixpkgs attributes the crate's ci-inputs file names, one per
# line (blank lines and # comments allowed), space-separated; nothing without the file.
ci_inputs() {
  local file="$1/ci-inputs" line n=0 words attrs=()
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    read -r -a words <<<"${line%%#*}"
    ((${#words[@]} == 0)) && continue
    ((${#words[@]} == 1)) || die "$file:$n: one nixpkgs attribute per line"
    [[ "${words[0]}" =~ ^[A-Za-z_][A-Za-z0-9_+-]*(\.[A-Za-z_][A-Za-z0-9_+-]*)*$ ]] \
      || die "$file:$n: not a nixpkgs attribute: '${words[0]}'"
    attrs+=("${words[0]}")
  done <"$file"
  ((${#attrs[@]} > 0)) || die "$file names no nixpkgs attribute"
  echo "${attrs[*]}"
}

# A crate with a ci-inputs file links system libraries (GTK, WebKitGTK, …) through
# pkg-config. `nix shell` runs no setup hooks, so it gives pkg-config no search path, and
# a .pc file's Requires (gtk4 → pango, cairo, glib, …) live in other packages' dev outputs.
# The legs run in a mkShell instead, from the same registry nixpkgs as `nix shell
# nixpkgs#cargo`: its setup hooks walk the propagated inputs into pkg-config's path, and
# its cc wrapper puts their library directories in the test binaries' rpath.
DEV_SHELL_EXPR='{ tools, inputs }:
  let
    pkgs = (builtins.getFlake "flake:nixpkgs").legacyPackages.${builtins.currentSystem};
    attrs = s: map (a: pkgs.lib.getAttrFromPath (pkgs.lib.splitString "." a) pkgs)
      (builtins.filter (a: a != "") (pkgs.lib.splitString " " s));
  in pkgs.mkShell { nativeBuildInputs = attrs tools; buildInputs = attrs inputs; }'

# in_dev_shell <inputs> <tools> <script> <crate dir>
in_dev_shell() {
  nix develop --impure --argstr inputs "$1" --argstr tools "$2" --expr "$DEV_SHELL_EXPR" \
    -c bash -c "$3" _ "$4"
}

# Same toolchain as the workspace jobs. --locked: a Cargo.lock that no longer matches
# Cargo.toml is a failure, not something to rewrite on the runner.
clippy() {
  local dir inputs
  dir="$(crate_dir "$1")" || return 1
  inputs="$(ci_inputs "$dir")" || return 1
  if [[ -n "$inputs" ]]; then
    in_dev_shell "$inputs" "cargo rustc clippy" \
      'cd "$1" && cargo clippy --locked --all-targets -- -D warnings' "$dir"
    return
  fi
  nix shell nixpkgs#cargo nixpkgs#rustc nixpkgs#clippy \
    -c bash -c 'cd "$1" && cargo clippy --locked --all-targets -- -D warnings' _ "$dir"
}

test_crate() {
  local dir inputs
  dir="$(crate_dir "$1")" || return 1
  inputs="$(ci_inputs "$dir")" || return 1
  if [[ -n "$inputs" ]]; then
    in_dev_shell "$inputs" "cargo rustc" 'cd "$1" && cargo test --locked' "$dir"
    return
  fi
  nix shell nixpkgs#cargo nixpkgs#rustc -c bash -c 'cd "$1" && cargo test --locked' _ "$dir"
}

# Regenerate Cargo.nix from a copy of the crate (what a path: input sees) with the flake's
# own crate2nix, format it as bin/ci/lint would, and compare. A crate without a Cargo.nix
# is packaged with buildRustPackage + cargoLock and has nothing to drift.
drift() {
  local dir
  dir="$(crate_dir "$1")" || return 1
  drift_dir "$dir"
}

drift_dir() {
  local dir="$1"
  if [[ ! -f "$dir/Cargo.nix" ]]; then
    echo "cargo-standalone: $dir has no Cargo.nix, nothing to drift"
    return 0
  fi
  local tmp status=0
  tmp="$(mktemp -d)" || return 1
  drift_in "$dir" "$tmp/crate" || status=$?
  rm -rf "$tmp"
  return "$status"
}

# Every workspace member's Cargo.nix, each regenerated from a copy of the member's directory
# alone: what its path: flake input sees, so its own Cargo.lock, not rust/Cargo.lock.
workspace_drift() {
  local members m failed=()
  members="$(list members)" || return 1
  echo "cargo-standalone: workspace members under rust/tools: $members"
  while IFS= read -r m; do
    drift_dir "rust/tools/$m" || failed+=("$m")
  done < <(jq -r '.[]' <<<"$members")
  ((${#failed[@]} == 0)) || die "Cargo.nix drift in: ${failed[*]}"
}

# drift_in <crate dir> <scratch dir>: the committed files only, with the old Cargo.nix
# removed, so a crate2nix that writes nothing cannot pass by leaving it in place.
drift_in() {
  local dir="$1" work="$2" f rel
  while IFS= read -r -d '' f; do
    rel="${f#"$dir"/}"
    mkdir -p "$work/$(dirname "$rel")" && cp "$f" "$work/$rel" || return 1
  done < <(git ls-files -z -- "$dir")
  rm -f "$work/Cargo.nix"
  nix shell --inputs-from . nixpkgs#crate2nix nixpkgs#cargo nixpkgs#rustc nixpkgs#alejandra \
    -c bash -c 'cd "$1" && crate2nix generate && alejandra -q Cargo.nix' _ "$work" || return 1
  if ! diff -u "$dir/Cargo.nix" "$work/Cargo.nix"; then
    echo "cargo-standalone: $dir/Cargo.nix is out of date: run crate2nix generate in $dir, then bin/ci/lint, and commit it" >&2
    return 1
  fi
  echo "cargo-standalone: $dir/Cargo.nix is up to date"
}

# The expression `package` builds: the crate's default.nix, callPackage'd with the host's
# pkgs, from the flake's copy of the tree. flakeRef is git_flake_ref's git+file reference,
# never the bare directory: getFlake on a path copies .git, target/ and the rest (#266).
PACKAGE_EXPR='{ flakeRef, crate, host }:
  let flake = builtins.getFlake flakeRef; # flake-ref: git-tracked
  in flake.nixosConfigurations.${host}.pkgs.callPackage "${flake}/rust/tools/${crate}/default.nix" { }'

package() {
  local dir host="${CARGO_STANDALONE_HOST:-drakkar}"
  dir="$(crate_dir "$1")" || return 1
  [[ "$host" =~ ^[A-Za-z0-9_-]+$ ]] || {
    echo "cargo-standalone: not a host name: '$host'" >&2
    return 1
  }
  if [[ ! -f "$dir/default.nix" ]]; then
    echo "cargo-standalone: $dir has no default.nix, no Nix package to build"
    return 0
  fi
  local ref
  ref="$(git_flake_ref "$ROOT")" || return 1
  echo "cargo-standalone: building $dir/default.nix with nixosConfigurations.$host.pkgs.callPackage"
  nix build --impure --no-link -L --argstr flakeRef "$ref" --argstr crate "$1" --argstr host "$host" \
    --expr "$PACKAGE_EXPR"
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  --list) list ;;
  --members) list members ;;
  workspace-drift) workspace_drift ;;
  clippy) clippy "${1:?usage: bin/ci/cargo-standalone clippy <crate>}" ;;
  test) test_crate "${1:?usage: bin/ci/cargo-standalone test <crate>}" ;;
  drift) drift "${1:?usage: bin/ci/cargo-standalone drift <crate>}" ;;
  package) package "${1:?usage: bin/ci/cargo-standalone package <crate>}" ;;
  all)
    if [[ $# -eq 0 ]]; then
      mapfile -t crates < <(list | jq -r '.[]')
    else
      crates=("$@")
    fi
    failed=()
    for c in "${crates[@]}"; do
      echo "=== $c"
      { clippy "$c" && test_crate "$c" && drift "$c" && package "$c"; } || failed+=("$c")
    done
    ((${#failed[@]} == 0)) || die "failed: ${failed[*]}"
    ;;
  *)
    sed -n '2,13s/^# \{0,1\}//p' "$0" >&2
    exit 64
    ;;
esac
