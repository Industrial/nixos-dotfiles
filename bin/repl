#!/usr/bin/env bash
# nix repl on this flake (also: bin/dev repl). Works from any directory.
set -euo pipefail

dotfiles_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$dotfiles_root"
mkdir -p logs
echo "> repl > cd $dotfiles_root"
exec > >(tee ./logs/repl) 2>&1
exec nix repl --extra-experimental-features "nix-command flakes" ".#"
