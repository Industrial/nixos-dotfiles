#!/usr/bin/env python3
"""Generate docs/security/stig-triage.md from the vendored projection + the hand classification.

Rows, ids, severities and requirement text come from the projection (mechanical).
class/target/note come from CLASSIFICATION below (hand-annotated, marked in the table).
"""

import json

Z, D, N = "zero-cost", "disruptive", "n-a"
BASE, FULL, EXCL = "base", "full", "excluded"

# id -> (class, target, note). Hand-authored; every `disruptive` row must name the
# concrete user-visible effect, every `n-a` row must carry a justification.
CLASSIFICATION = {
    # --- firewall / network ---
    "V-268078": (Z, BASE, "`networking.firewall.enable = true` — already on via features/nixos/networking/firewall.nix"),
    # Reclassified 2026-10-28 while implementing group 1: the fix text is not "firewall on",
    # it is explicit hashlimit rules that REFUSE SSH traffic above 1 MB/s per source IP.
    "V-268158": (D, FULL, "hashlimit rules refuse SSH above 1 MB/s per source IP — large scp/rsync transfers start getting dropped"),
    # Reclassified 2026-10-28: the broad title says flooding/capacity, the fix and check are
    # exactly `net.ipv4.tcp_syncookies = 1` and nothing else.
    "V-268141": (Z, BASE, "`net.ipv4.tcp_syncookies = 1`; title says flooding/capacity, check tests only this sysctl"),
    # --- accounts / policy ---
    "V-268079": (N, EXCL, "No emergency or temporary accounts exist on any host. Justification must be re-asserted if one is ever created"),
