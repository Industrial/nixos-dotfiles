    "V-268167": (Z, BASE, "Audit rule: account create/modify/disable/terminate"),
    "V-268103": (Z, BASE, "auditd `space_left_action` at 75%"),
    "V-268104": (Z, BASE, "auditd `admin_space_left_action` at 90%"),
    # Stays base-safe, but NOT at the fix text's value. The fix text says HALT, which powers
    # the machine down when the audit volume fills — an unplanned shutdown mid-work. The CHECK
    # text accepts "SYSLOG", "SINGLE", or "HALT", so SYSLOG is fully compliant and harmless.
    "V-268105": (Z, BASE, "`disk_full_action = SYSLOG`; check accepts SYSLOG/SINGLE/HALT, so the fix text's HALT is avoidable"),
    "V-268106": (Z, BASE, "`disk_error_action = SYSLOG`; check accepts SYSLOG/SINGLE/HALT, so the fix text's HALT is avoidable"),
    # --- audit notification + offload (need site input) ---
    "V-268101": (D, FULL, "Needs a real SA/ISSO mail destination; without one the 75% notification silently goes nowhere"),
    "V-268102": (D, FULL, "Needs a real SA/ISSO mail destination for the 90% notification"),
    "V-268107": (Z, BASE, "`services.journald.audit = true`"),
    "V-268108": (D, FULL, "Requires a reachable remote journal endpoint plus client key/cert; journald upload fails loudly without them"),
    "V-268109": (D, FULL, "Requires the remote logging server's CA; unauthenticated upload is a finding"),
    # --- log file ownership and modes ---
    "V-268110": (Z, BASE, "Audit logs group-owned by root"),
    "V-268111": (Z, BASE, "Audit directory and logs owned by root"),
