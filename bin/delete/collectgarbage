#!/usr/bin/env bash
echo "> delete > collectgarbage"
exec > >(tee ./logs/delete-collectgarbage) 2>&1
set -e

source "$(dirname "$0")/../lib/root-cmd.sh"

# vgc (rust/tools/vgc) is the fleet's collector; -d is nix-collect-garbage's
# --delete-old: every generation but the current one, then a collection.
echo "> vgc run --delete-old"
root_cmd vgc run --delete-old
