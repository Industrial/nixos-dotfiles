#!/usr/bin/env bash
# Bump flake.lock by hand: one pull request per input, through vbump.
#
#   bin/update/flake [--dry-run] [--input NAME]... [--auto-merge]   (any `vbump run` option)
#
# The scheduled path is .github/workflows/vbump.yml, which runs the same `vbump run`
# weekly with --auto-merge. vbump relocks each root input on its own against
# origin/main's commit (never the work tree), evaluates and dry-builds every host, diffs
# each host's closure and opens or refreshes that input's PR
# (docs/adr/0006-update-policy.md). `--dry-run` does all of it but push and open.
#
# vbump is the only lock updater (GH-247): there is no whole-lock fallback here. The
# rollback is restoring the old workflow and this script from git history
# (docs/runbooks/updates.md §1).
echo "> update > flake"
dotfiles_root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$dotfiles_root"
mkdir -p ./logs
exec > >(tee ./logs/update-flake) 2>&1
set -e

if ! command -v vbump >/dev/null 2>&1; then
  echo "> update > flake > vbump is not on PATH (features.cli.vbump), and it is the only lock updater."
  echo "> update > flake >   run the \"Update flake.lock (vbump)\" workflow: gh workflow run vbump.yml"
  exit 1
fi

echo "> update > flake > git fetch origin main"
git fetch --quiet origin main
echo "> update > flake > vbump run --rev origin/main $*"
exec vbump run --rev origin/main "$@"
