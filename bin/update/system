#!/usr/bin/env bash
set -e

dotfiles_root="$(cd "$(dirname "$0")/../.." && pwd)"
log_file="$dotfiles_root/logs/update-system"
mkdir -p "$(dirname "$log_file")"

echo "> update > system"
if command -v stdbuf >/dev/null 2>&1; then
  exec > >(stdbuf -oL tee "$log_file") 2>&1
else
  exec > >(tee "$log_file") 2>&1
fi

source "$(dirname "$0")/../lib/root-cmd.sh"

host_dir="$dotfiles_root"

echo "> update > system > cd $host_dir"
cd "$host_dir"

# Converge only from merged main (docs/adr/0006-update-policy.md). comin switches every
# host to origin/main every 300s (ADR-0002), so switching to anything else here is either
# reverted within five minutes or, worse, survives because comin is stopped. Experiments
# go to the testing-<hostname> branch instead. UPDATE_ALLOW_UNMERGED=1 overrides, for
# console recovery when the network or GitHub is down.
if [ "${UPDATE_ALLOW_UNMERGED:-0}" != 1 ]; then
  if ! git fetch --quiet origin main; then
    echo "> update > system > cannot fetch origin/main; refusing (UPDATE_ALLOW_UNMERGED=1 overrides)"
    exit 1
  fi
  head_rev="$(git rev-parse HEAD)"
  main_rev="$(git rev-parse origin/main)"
  # Submodules (.claude-setup) are not part of the flake source, so they do not count.
  dirty="$(git status --porcelain --untracked-files=no --ignore-submodules=all)"
  if [ "$head_rev" != "$main_rev" ] || [ -n "$dirty" ]; then
    echo "> update > system > refusing: this tree is not origin/main."
    echo "> update > system >   HEAD:        $head_rev"
    echo "> update > system >   origin/main: $main_rev"
    [ -n "$dirty" ] && echo "> update > system >   uncommitted tracked changes present"
    echo "> update > system > Merge the change (lock bumps: the update-flake-lock PR) and"
    echo "> update > system > 'git switch main && git pull --ff-only', or push to"
    echo "> update > system > testing-$(hostname) for a one-host experiment."
    exit 1
  fi
fi

# Always `switch` so the new generation is activated immediately (PATH, services, new
# packages). Some upgrades still need a reboot for the kernel or firmware path to match
# `/run/booted-system`; if `switch` is blocked (switch inhibitors / known breaking changes),
# run `sudo nixos-rebuild boot --flake ".#$(hostname)"` manually and reboot.
booted="$(readlink -f /run/booted-system)"
profile="$(readlink -f /nix/var/nix/profiles/system)"
if [ "$booted" != "$profile" ]; then
  echo "> update > system > booted != default profile (will activate profile with switch)"
  echo "> update > system >   booted:  $booted"
  echo "> update > system >   profile: $profile"
fi
# vswitch is the local rebuild (GH-241): it builds as this user (through vmon), prints the
# closure diff, and elevates only the activation, which is vdeploy's apply: health-checked
# with vhealth, rolled back when unhealthy, in vdeploy's own unit. Without vswitch (a host
# that rolled it back), nixos-rebuild switches as before.
if command -v vswitch >/dev/null 2>&1; then
  echo "> update > system > vswitch switch --flake $host_dir --host $(hostname)"
  switch="vswitch switch --flake '$host_dir' --host '$(hostname)'"
  if command -v script >/dev/null 2>&1; then
    # exec>tee makes stdout a pipe; script allocates a pty so sudo can prompt and nix keeps
    # line buffering.
    script -qefc "$switch" /dev/null
  else
    sh -c "$switch"
  fi
  vswitched=1
fi
# Build the closure through vmon, the build monitor (GH-181), as this user: the switch
# below then finds it in the store and only activates. Without vmon (a host that rolled
# it back), nixos-rebuild builds it as before.
if [ -z "${vswitched:-}" ] && command -v vmon >/dev/null 2>&1; then
  toplevel=".#nixosConfigurations.$(hostname).config.system.build.toplevel"
  echo "> update > system > vmon -- nix build --no-link $toplevel"
  vmon -- nix build --no-link "$toplevel"
fi
if [ -z "${vswitched:-}" ]; then
  echo "> update > system > nixos-rebuild switch --flake \".#$(hostname)\""
  rebuild="cd '$host_dir' && nixos-rebuild switch --flake '.#$(hostname)' --show-trace --print-build-logs"
  if command -v script >/dev/null 2>&1; then
    # exec>tee makes stdout a pipe; script allocates a pty so nix keeps line buffering.
    root_cmd script -qefc "$rebuild" /dev/null
  else
    root_cmd sh -c "$rebuild"
  fi
fi

cd "$dotfiles_root"

# The login shell is NOT set here. `users.users.<name>.shell` in the NixOS config is the
# single writer; activation applies it. See docs/adr/0005-shell-strategy.md.
features/network/ladybird/bin/link-files-nixos
features/programming/cursor/bin/link-files-nixos
features/ai/opencode/bin/link-files-nixos
features/ai/openhands/bin/link-files-nixos
# features/cli/nushell has no link script: its `vfiles.files` and features/cli/shell-init's
# vendor-autoload link are the single writers, placed by the vfiles activation step the
# switch above already ran. The old script was a second, divergent writer of the
# same symlinks (it never linked havamal-stanzas and never chowned).
