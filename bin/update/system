#!/usr/bin/env bash
set -e

dotfiles_root="$(cd "$(dirname "$0")/../.." && pwd)"
log_file="$dotfiles_root/logs/update-system"
mkdir -p "$(dirname "$log_file")"

echo "> update > system"
if command -v stdbuf >/dev/null 2>&1; then
  exec > >(stdbuf -oL tee "$log_file") 2>&1
else
  exec > >(tee "$log_file") 2>&1
fi

source "$(dirname "$0")/../lib/root-cmd.sh"

host_dir="$dotfiles_root/hosts/$(hostname)"

echo "> update > system > cd $host_dir"
cd "$host_dir"

# Always `switch` so the new generation is activated immediately (PATH, services, new
# packages). Some upgrades still need a reboot for the kernel or firmware path to match
# `/run/booted-system`; if `switch` is blocked (switch inhibitors / known breaking changes),
# run `sudo nixos-rebuild boot --flake ".#$(hostname)"` manually and reboot.
booted="$(readlink -f /run/booted-system)"
profile="$(readlink -f /nix/var/nix/profiles/system)"
if [ "$booted" != "$profile" ]; then
  echo "> update > system > booted != default profile (will activate profile with switch)"
  echo "> update > system >   booted:  $booted"
  echo "> update > system >   profile: $profile"
fi
echo "> update > system > nixos-rebuild switch --flake \".#$(hostname)\""
# --print-build-logs (-L) + --log-format raw: multiline build logs instead of the
# single-line progress status ("[N/M built] building …").
rebuild="cd '$host_dir' && nixos-rebuild switch --flake '.#$(hostname)' --show-trace --print-build-logs --log-format raw --option eval-cache false"
if command -v script >/dev/null 2>&1; then
  # exec>tee makes stdout a pipe; script allocates a pty so nix keeps line buffering.
  root_cmd script -qefc "$rebuild" /dev/null
else
  root_cmd sh -c "$rebuild"
fi

cd "$dotfiles_root"
bin/update/login-shell "tom"

features/network/ladybird/bin/link-files-nixos
features/programming/cursor/bin/link-files-nixos
features/ai/opencode/bin/link-files-nixos
features/ai/hermes-agent/bin/link-files-nixos
