#!/usr/bin/env bash
# World of Warcraft management script

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_ROOT="$(dirname "$SCRIPT_DIR")"

case "${1:-link}" in
  link)
    cd "$DOTFILES_ROOT"
    exec features/games/wow-classic/bin/link-wow-classic
    ;;
  seed-character)
    shift
    cd "$DOTFILES_ROOT"
    exec features/games/wow-classic/bin/seed-wow-character "$@"
    ;;
  *)
    echo "Usage: wow <command> [args]"
    echo ""
    echo "Commands:"
    echo "  link                       Symlink WTF and Interface into the WoW install (default)"
    echo "  seed-character <Name>      Give a character an existing character's settings"
    echo ""
    echo "Examples:"
    echo "  wow link"
    echo "  wow seed-character \"Some Character\""
    echo "  wow seed-character \"Some Character\" --from \"Other Character\""
    exit 1
    ;;
esac
