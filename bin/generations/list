#!/usr/bin/env bash
echo "> generations > list"
exec > >(tee ./logs/list-generations) 2>&1
set -e

# vgen (features/nixos/vgen) lists every system profile, comin's included, with a
# closure diff between neighbouring generations. comin's profile is root-only, so
# without root vgen notes it and lists the rest. Without vgen (the feature rolled
# back), the profile links are listed as before.
if command -v vgen >/dev/null; then
    exec vgen list "$@"
fi
for file in /nix/var/nix/profiles/system-*; do
    if [[ -e "$file" ]]; then
        basename "$file"
    fi
done
