#!/usr/bin/env bash
# Fleet push-deploy wrapper (deploy-rs).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

HOSTS=(drakkar huginn mimir muninn)

deploy_cmd() {
  nix run --accept-flake-config github:serokell/deploy-rs -- "$@"
}

# Build a node's profile through vmon, the build monitor (GH-181), before deploy-rs
# copies and activates it: deploy-rs then finds it in the store. Without vmon
# (a host that rolled it back), deploy-rs builds it as before.
prebuild() {
  command -v vmon >/dev/null 2>&1 || return 0
  echo "> fleet build .#deploy.nodes.$1.profiles.system.path (vmon)"
  vmon -- nix build --no-link ".#deploy.nodes.$1.profiles.system.path"
}

usage() {
  cat <<EOF
Usage: fleet <command> [host|all] [deploy-rs flags...]

Commands:
  status              SSH reachability probe for all hosts
  check [host|all]    nix flake check; optional --dry-activate per host
  deploy [host|all]   deploy-rs activate (pass --dry-activate to dry-run)

Examples:
  fleet check huginn
  fleet deploy huginn --dry-activate
  fleet deploy all
EOF
  exit 1
}

[[ $# -ge 1 ]] || usage
cmd="$1"
shift

case "$cmd" in
  status)
    for h in "${HOSTS[@]}"; do
      printf '=== %s ===\n' "$h"
      if ssh -o ConnectTimeout=5 -o BatchMode=yes "$h" hostname 2>/dev/null; then
        echo ok
      else
        echo unreachable
      fi
    done
    ;;
  check)
    nix flake check
    target="${1:-}"
    shift || true
    if [[ -z "$target" || "$target" == "all" ]]; then
      for h in "${HOSTS[@]}"; do
        echo "> fleet check deploy .#$h --dry-activate"
        deploy_cmd ".#$h" --dry-activate "$@" || true
      done
    else
      deploy_cmd ".#$target" --dry-activate "$@"
    fi
    ;;
  deploy)
    target="${1:-}"
    [[ -n "$target" ]] || usage
    shift
    if [[ "$target" == "all" ]]; then
      # Per-host so one unreachable node does not block the rest.
      failed=0
      for h in "${HOSTS[@]}"; do
        echo "> fleet deploy .#$h"
        if ! prebuild "$h" || ! deploy_cmd ".#$h" --skip-checks "$@"; then
          echo "> fleet deploy .#$h FAILED (continuing)"
          failed=1
        fi
      done
      exit "$failed"
    else
      prebuild "$target"
      deploy_cmd ".#$target" --skip-checks "$@"
    fi
    ;;
  *) usage ;;
esac
