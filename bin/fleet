#!/usr/bin/env bash
# Fleet deploy wrapper.
#
# `fleet deploy` wakes each host's vdeploy (GH-246): `vdeploy wake --wait` over ssh, as the
# operator. The wake carries nothing; the host polls main from its pinned URL, verifies it,
# and deploys it with vdeploy's own health check and rollback, so only merged main is ever
# deployed (ADR-0006). deploy-rs is the one rollback, `fleet deploy --legacy`, pinned to the
# flake's own deploy-rs input (no longer an unpinned `nix run` of its GitHub repository, #143).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

HOSTS=(drakkar huginn mimir muninn)

# deploy-rs, the rollback: from the flake's locked input, never an unpinned ref.
deploy_cmd() {
  nix run --accept-flake-config --inputs-from "$ROOT" deploy-rs -- "$@"
}

# Build a node's profile through vmon, the build monitor (GH-181), before deploy-rs
# copies and activates it: deploy-rs then finds it in the store. Without vmon
# (a host that rolled it back), deploy-rs builds it as before.
prebuild() {
  command -v vmon >/dev/null 2>&1 || return 0
  echo "> fleet build .#deploy.nodes.$1.profiles.system.path (vmon)"
  vmon -- nix build --no-link ".#deploy.nodes.$1.profiles.system.path"
}

# One host's wake, followed to its outcome. An offline host fails at the ssh connect (5 s);
# a host that does not settle in time is cut off at its timeout plus a minute.
wake_one() {
  local host=$1 secs=$2
  timeout "$((secs + 60))" ssh -o ConnectTimeout=5 -o BatchMode=yes "$host" \
    vdeploy wake --wait --timeout "$secs"
}

usage() {
  cat <<EOF
Usage: fleet <command> [host|all] [options]

Commands:
  status                          SSH reachability probe for all hosts
  check [host|all]                nix flake check; deploy-rs --dry-activate per host
  deploy <host|all> [--timeout SECONDS]
                                  wake vdeploy on the host(s): it polls main now and
                                  deploys it, health-checked (one result line per host)
  deploy <host|all> --legacy [deploy-rs flags...]
                                  the rollback: deploy-rs from the flake's pinned input

Examples:
  fleet deploy mimir
  fleet deploy all --timeout 900
  fleet deploy huginn --legacy --dry-activate
EOF
  exit 1
}

[[ $# -ge 1 ]] || usage
cmd="$1"
shift

case "$cmd" in
  status)
    for h in "${HOSTS[@]}"; do
      printf '=== %s ===\n' "$h"
      if ssh -o ConnectTimeout=5 -o BatchMode=yes "$h" hostname 2>/dev/null; then
        echo ok
      else
        echo unreachable
      fi
    done
    ;;
  check)
    nix flake check
    target="${1:-}"
    shift || true
    if [[ -z "$target" || "$target" == "all" ]]; then
      for h in "${HOSTS[@]}"; do
        echo "> fleet check deploy .#$h --dry-activate"
        deploy_cmd ".#$h" --dry-activate "$@" || true
      done
    else
      deploy_cmd ".#$target" --dry-activate "$@"
    fi
    ;;
  deploy)
    target="${1:-}"
    [[ -n "$target" ]] || usage
    shift
    if [[ "${1:-}" == "--legacy" ]]; then
      shift
      if [[ "$target" == "all" ]]; then
        # Per-host so one unreachable node does not block the rest.
        failed=0
        for h in "${HOSTS[@]}"; do
          echo "> fleet deploy --legacy .#$h"
          if ! prebuild "$h" || ! deploy_cmd ".#$h" --skip-checks "$@"; then
            echo "> fleet deploy --legacy .#$h FAILED (continuing)"
            failed=1
          fi
        done
        exit "$failed"
      else
        prebuild "$target"
        deploy_cmd ".#$target" --skip-checks "$@"
      fi
      exit 0
    fi
    secs=1800
    if [[ "${1:-}" == "--timeout" ]]; then
      secs="${2:?--timeout needs seconds}"
      shift 2
    fi
    [[ $# -eq 0 ]] || usage
    if [[ "$target" == "all" ]]; then
      hosts=("${HOSTS[@]}")
    else
      hosts=("$target")
    fi
    # Every host at once, each into its own log: one hung host cannot hold the others.
    logs="$(mktemp -d)"
    trap 'rm -rf "$logs"' EXIT
    declare -A pids
    for h in "${hosts[@]}"; do
      wake_one "$h" "$secs" >"$logs/$h" 2>&1 &
      pids[$h]=$!
    done
    failed=0
    for h in "${hosts[@]}"; do
      if wait "${pids[$h]}"; then
        status=ok
      else
        status="FAILED ($?)"
        failed=1
      fi
      last="$(tail -n 1 "$logs/$h" 2>/dev/null || true)"
      printf '%-8s %-12s %s\n' "$h" "$status" "${last:-(no output)}"
    done
    exit "$failed"
    ;;
  *) usage ;;
esac
